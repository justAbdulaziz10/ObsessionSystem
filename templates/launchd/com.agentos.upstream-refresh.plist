<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agentos.upstream-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; "$HOME/bin/agent-upstream" refresh; "$HOME/bin/agent-cap" refresh --quiet</string>
  </array>
  <key>StartInterval</key><integer>86400</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/agentos-upstream-refresh.log</string>
  <key>StandardErrorPath</key><string>/tmp/agentos-upstream-refresh.log</string>
</dict>
</plist>
