#!/usr/bin/env python3

import json
import os
import re
import shutil
import sys
import time
import urllib.request
from pathlib import Path
from datetime import datetime

HOME = Path.home()
BASE = HOME / ".agent-os"
STATE = BASE / "models.json"
STAMP = BASE / "state" / "models-refreshed-at"

OPENAI_CATALOG = (
    "https://raw.githubusercontent.com/openai/codex/"
    "main/codex-rs/models-manager/models.json"
)

ANTHROPIC_MODELS = (
    "https://docs.anthropic.com/en/docs/about-claude/"
    "model-deprecations"
)

LUNA_RE = re.compile(r"^gpt-(\d+(?:\.\d+)*)-luna$")
OPUS_RE = re.compile(r"^claude-opus-(\d+(?:-\d+)*)$")


def vtuple(value):
    return tuple(int(x) for x in re.findall(r"\d+", value))


def fetch(url):
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "AgentOS/1.0"},
        )
        with urllib.request.urlopen(req, timeout=8) as r:
            return r.read().decode("utf-8", errors="ignore")
    except Exception:
        return ""


def collect_strings(obj):
    found = set()

    if isinstance(obj, str):
        found.add(obj)

    elif isinstance(obj, list):
        for x in obj:
            found |= collect_strings(x)

    elif isinstance(obj, dict):
        for k, v in obj.items():
            found |= collect_strings(k)
            found |= collect_strings(v)

    return found


def local_lunas():
    all_sets = []

    for p in [
        HOME / ".codex" / "models_cache.json",
        HOME / ".codex_second" / "models_cache.json",
    ]:
        if not p.exists():
            continue

        try:
            obj = json.loads(p.read_text())
            vals = {
                x for x in collect_strings(obj)
                if LUNA_RE.fullmatch(x)
            }

            if vals:
                all_sets.append(vals)
        except Exception:
            pass

    return all_sets


def remote_lunas():
    raw = fetch(OPENAI_CATALOG)

    if not raw:
        return set()

    try:
        obj = json.loads(raw)
    except Exception:
        return set()

    result = set()

    models = obj.get("models", []) if isinstance(obj, dict) else []

    for m in models:
        if not isinstance(m, dict):
            continue

        slug = m.get("slug")

        if not isinstance(slug, str):
            continue

        if not LUNA_RE.fullmatch(slug):
            continue

        levels = m.get("supported_reasoning_levels", [])
        efforts = {
            x.get("effort")
            for x in levels
            if isinstance(x, dict)
        }

        if "xhigh" in efforts:
            result.add(slug)

    return result


def resolve_luna(previous):
    remote = remote_lunas()

    if remote:
        return max(remote, key=vtuple), "openai-official-catalog"

    local = local_lunas()

    if len(local) >= 2:
        common = set.intersection(*local)

        if common:
            return max(common, key=vtuple), "local-account-intersection"

    if local:
        union = set.union(*local)
        return max(union, key=vtuple), "local-codex-cache"

    return previous or "gpt-6-luna", "fallback"


def resolve_opus(previous):
    candidates = set()

    raw = fetch(ANTHROPIC_MODELS)

    if raw:
        for value in re.findall(
            r"claude-opus-\d+(?:-\d+){0,2}",
            raw,
            flags=re.I,
        ):
            value = value.lower()

            if OPUS_RE.fullmatch(value):
                parts = re.findall(r"\d+", value)

                if len(parts) <= 3:
                    candidates.add(value)

    # Never downgrade below something already configured locally.
    for p in [
        HOME / ".t3" / "userdata" / "settings.json",
        HOME / ".claude" / "settings.json",
        HOME / ".claude_second" / "settings.json",
    ]:
        if not p.exists():
            continue

        text = p.read_text(errors="ignore")

        for value in re.findall(
            r"claude-opus-\d+(?:-\d+){0,2}",
            text,
        ):
            if OPUS_RE.fullmatch(value):
                candidates.add(value)

    if previous and OPUS_RE.fullmatch(previous):
        candidates.add(previous)

    if candidates:
        return max(candidates, key=vtuple), "anthropic/local"

    return previous or "opus", "family-alias"


def load_previous():
    if not STATE.exists():
        return {}

    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {}


def patch_codex_model(path, model):
    if not path.exists() or path.is_symlink():
        if path.is_symlink():
            path = path.resolve()
        else:
            return False

    text = path.read_text(errors="ignore")
    original = text

    text = re.sub(
        r"gpt-\d+(?:\.\d+)*-luna",
        model,
        text,
    )

    text = re.sub(
        r'model_reasoning_effort=\\"?(?:low|medium|high|xhigh|max|ultra)\\"?',
        'model_reasoning_effort="xhigh"',
        text,
    )

    if text != original:
        path.write_text(text)
        path.chmod(0o755)
        return True

    return False


def patch_runtime_config(model):
    paths = [
        BASE / "runtime" / "config.json",
        BASE / "config.json",
    ]

    for p in paths:
        if not p.exists():
            continue

        try:
            data = json.loads(p.read_text())
        except Exception:
            continue

        data["codex_model"] = model
        data["codex_family"] = "luna"
        data["codex_effort"] = "xhigh"
        data["codex_reasoning_effort"] = "xhigh"

        p.write_text(json.dumps(data, indent=2) + "\n")


def patch_claude_settings(opus_exact):
    for p in [
        HOME / ".claude" / "settings.json",
        HOME / ".claude_second" / "settings.json",
    ]:
        p.parent.mkdir(parents=True, exist_ok=True)

        try:
            data = json.loads(p.read_text()) if p.exists() else {}
        except Exception:
            backup = p.with_name(
                p.name + ".pre-agentos-models"
            )

            if p.exists():
                shutil.copy2(p, backup)

            data = {}

        # Family alias means Claude Code tracks the current Opus family.
        data["model"] = "opus"

        env = data.setdefault("env", {})
        env["FORCE_AUTOUPDATE_PLUGINS"] = "1"
        env["CLAUDE_CODE_SYNC_PLUGIN_INSTALL"] = "1"

        if opus_exact.startswith("claude-opus-"):
            env["ANTHROPIC_DEFAULT_OPUS_MODEL"] = opus_exact

        p.write_text(json.dumps(data, indent=2) + "\n")


def patch_t3_preferences(opus_exact):
    p = HOME / ".t3" / "userdata" / "settings.json"

    if not p.exists():
        return 0

    try:
        data = json.loads(p.read_text())
    except Exception:
        return 0

    changed = 0

    def walk(obj):
        nonlocal changed

        if isinstance(obj, dict):
            for k, v in list(obj.items()):
                if (
                    k == "model"
                    and isinstance(v, str)
                    and v.startswith("claude-opus-")
                    and opus_exact.startswith("claude-opus-")
                ):
                    if vtuple(opus_exact) > vtuple(v):
                        obj[k] = opus_exact
                        changed += 1
                else:
                    walk(v)

        elif isinstance(obj, list):
            for x in obj:
                walk(x)

    walk(data)

    if changed:
        backup = p.with_name(
            f"settings.json.agentos-backup-"
            f"{datetime.now().strftime('%Y%m%d-%H%M%S')}"
        )

        shutil.copy2(p, backup)
        p.write_text(json.dumps(data, indent=2) + "\n")

    return changed


def refresh(quiet=False):
    BASE.mkdir(parents=True, exist_ok=True)
    (BASE / "state").mkdir(parents=True, exist_ok=True)

    previous = load_previous()

    luna, luna_source = resolve_luna(
        previous.get("codex_luna")
    )

    opus, opus_source = resolve_opus(
        previous.get("claude_opus_resolved")
    )

    changed_scripts = []

    for p in [
        HOME / "bin" / "codex-ha",
        HOME / "bin" / "agent-codex",
    ]:
        if patch_codex_model(p, luna):
            changed_scripts.append(str(p))

    patch_runtime_config(luna)
    patch_claude_settings(opus)
    t3_updates = patch_t3_preferences(opus)

    state = {
        "updated_at": datetime.now().astimezone().isoformat(),
        "claude_selector": "opus",
        "claude_opus_resolved": opus,
        "claude_source": opus_source,
        "codex_family": "luna",
        "codex_luna": luna,
        "codex_source": luna_source,
        "codex_effort": "xhigh",
        "previous_luna": previous.get("codex_luna"),
        "t3_preferences_updated": t3_updates,
    }

    STATE.write_text(
        json.dumps(state, indent=2) + "\n"
    )

    STAMP.write_text(str(time.time()))

    if not quiet:
        print("AgentOS models")
        print(f"Claude lead family : opus")
        print(f"Resolved Opus      : {opus}")
        print(f"Codex worker       : {luna}")
        print(f"Codex effort       : xhigh")
        print(f"T3 prefs upgraded  : {t3_updates}")

        if changed_scripts:
            print("Patched:")
            for x in changed_scripts:
                print(" ", x)


def stale(seconds):
    if not STAMP.exists():
        return True

    try:
        last = float(STAMP.read_text().strip())
    except Exception:
        return True

    return (time.time() - last) >= seconds


args = sys.argv[1:]

quiet = "--quiet" in args

if not args or args[0] == "refresh":
    if "--if-stale" in args:
        i = args.index("--if-stale")

        try:
            seconds = int(args[i + 1])
        except Exception:
            seconds = 21600

        if not stale(seconds):
            if not quiet:
                print("Model catalog still fresh.")
            raise SystemExit(0)

    refresh(quiet=quiet)
    raise SystemExit(0)

if args[0] == "status":
    if STATE.exists():
        print(STATE.read_text())
    else:
        print("No model state yet.")
    raise SystemExit(0)

if args[0] == "rollback-luna":
    state = load_previous()
    previous = state.get("previous_luna")

    if not previous:
        print("No previous Luna recorded.", file=sys.stderr)
        raise SystemExit(1)

    for p in [
        HOME / "bin" / "codex-ha",
        HOME / "bin" / "agent-codex",
    ]:
        patch_codex_model(p, previous)

    state["codex_luna"] = previous
    STATE.write_text(json.dumps(state, indent=2) + "\n")
    print(f"Rolled back Luna to {previous}")
    raise SystemExit(0)

print(
    "Usage: agent-models refresh [--if-stale SEC] [--quiet] | "
    "status | rollback-luna"
)
raise SystemExit(1)
