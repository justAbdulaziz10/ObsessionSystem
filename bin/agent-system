#!/usr/bin/env python3

from pathlib import Path
import argparse


H = Path.home()
A = H / ".agent-os"


def read(path):
    try:
        return Path(path).read_text()
    except Exception:
        return "(missing)\n"


def main():
    parser = argparse.ArgumentParser(
        prog="agent-system"
    )

    parser.add_argument(
        "--full",
        action="store_true",
        help="Print SYSTEM.md and STATE.md in full.",
    )

    parser.add_argument(
        "--audit-prompt",
        action="store_true",
        help="Print the ready-to-paste Claude AgentOS audit prompt.",
    )

    args = parser.parse_args()

    if args.audit_prompt:
        print(
            read(
                A / "PROMPT_FOR_CLAUDE.md"
            )
        )
        return

    if args.full:
        print(
            read(
                A / "SYSTEM.md"
            )
        )

        print(
            "\n\n"
            "================ LIVE STATE ================\n"
        )

        print(
            read(
                A / "STATE.md"
            )
        )

        return

    print("AgentOS Canonical System")
    print()
    print(f"SYSTEM       {A / 'SYSTEM.md'}")
    print(f"STATE        {A / 'STATE.md'}")
    print(f"DECISIONS    {A / 'DECISIONS.md'}")
    print(f"CHANGELOG    {A / 'CHANGELOG.md'}")
    print(f"LESSONS      {A / 'LESSONS.md'}")
    print(f"IMPROVEMENTS {A / 'IMPROVEMENTS.md'}")
    print(f"AUDIT PROMPT {A / 'PROMPT_FOR_CLAUDE.md'}")
    print()
    print("For current machine state:")
    print(f"  cat {A / 'STATE.md'}")
    print()
    print("For complete canonical context:")
    print("  agent-system --full")
    print()
    print("For the ready Claude audit prompt:")
    print("  agent-system --audit-prompt")


if __name__ == "__main__":
    main()
