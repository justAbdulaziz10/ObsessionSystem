#!/usr/bin/env python3

from __future__ import annotations

from pathlib import Path
from datetime import datetime
import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess


H = Path.home()
A = H / ".agent-os"
STATE = A / "STATE.md"


def load_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return {} if default is None else default


def load_toml(path):
    text = Path(path).read_text()

    try:
        import tomllib

        return tomllib.loads(text)

    except ImportError:
        # /usr/bin/python3 (3.9) has no tomllib; only top-level
        # [mcp_servers.<name>] and [plugins."<name>"] tables are needed.
        data = {}

        for section in ("mcp_servers", "plugins"):
            data[section] = {
                m.group(2): {}
                for m in re.finditer(
                    rf'^\[{section}\.("?)([^"\]]+)\1\]\s*$',
                    text,
                    re.M,
                )
                if section == "plugins" or "." not in m.group(2)
            }

        return data


def run(cmd, env=None, timeout=20):
    try:
        p = subprocess.run(
            cmd,
            env=env,
            text=True,
            capture_output=True,
            timeout=timeout,
        )

        return (
            p.returncode,
            (p.stdout or "") + (p.stderr or ""),
        )

    except Exception:
        return 1, ""


def count_files_named(root, name):
    root = Path(root)

    if not root.exists():
        return 0

    found = set()

    for cur, dirs, files in os.walk(
        root,
        followlinks=True,
    ):
        dirs[:] = [
            d
            for d in dirs
            if d not in {
                ".git",
                "node_modules",
                "DerivedData",
                ".build",
            }
        ]

        if name in files:
            p = Path(cur) / name

            try:
                found.add(str(p.resolve()))
            except Exception:
                found.add(str(p))

    return len(found)


def count_skills():
    return count_files_named(
        H / ".agents" / "skills",
        "SKILL.md",
    )


def count_plugins(root):
    return count_files_named(
        root,
        "plugin.json",
    )


def symlink_state(path, expected=None):
    path = Path(path)

    if not path.exists() and not path.is_symlink():
        return "missing"

    if not path.is_symlink():
        return "not a symlink"

    try:
        target = path.resolve()

        if expected:
            exp = Path(expected).resolve()

            if target == exp:
                return f"→ {target} ✅"

            return f"→ {target} ⚠ expected {exp}"

        return f"→ {target}"

    except Exception:
        return "broken symlink ⚠"


def resolve_models():
    v2 = load_json(
        A / "v2" / "candidates" / "models.json",
        {},
    )

    legacy = load_json(
        A / "models.json",
        {},
    )

    current = (
        v2.get("current")
        or v2.get("current_luna")
        or legacy.get("codex_luna")
    )

    candidate = (
        v2.get("candidate")
        or v2.get("candidate_luna")
        or "none"
    )

    regex = re.compile(
        r"gpt-\d+(?:\.\d+)*-luna"
    )

    if not current:
        for path in [
            H / "bin" / "codex-ha",
            H / "bin" / "agent-codex",
        ]:
            try:
                match = regex.search(
                    path.read_text(errors="ignore")
                )

                if match:
                    current = match.group(0)
                    break

            except Exception:
                pass

    effort = "unknown"

    effort_regex = re.compile(
        r'model_reasoning_effort\s*=?\s*["\'](xhigh|high|medium|low)["\']'
    )

    for path in [
        H / ".codex" / "config.toml",
        H / "bin" / "codex-ha",
        H / "bin" / "agent-codex",
    ]:
        try:
            match = effort_regex.search(
                path.read_text(errors="ignore")
            )

            if match:
                effort = match.group(1)
                break

        except Exception:
            pass

    return (
        current or "unknown",
        candidate,
        effort,
    )


def claude_model(root):
    data = load_json(
        Path(root) / "settings.json",
        {},
    )

    selector = data.get(
        "model",
        "default/unknown",
    )

    env = data.get(
        "env",
        {},
    )

    exact = env.get(
        "ANTHROPIC_DEFAULT_OPUS_MODEL",
        "",
    )

    return selector, exact


def mcp_inventory():
    path = (
        H
        / ".config"
        / "mcpall"
        / "servers.json"
    )

    data = load_json(path, {})

    names = []

    # mcpall v3 writes a top-level list of {"name", "type", ...};
    # older manifests used {"servers": {...}} or a name-keyed dict.
    if isinstance(data, (dict, list)):
        servers = (
            data.get(
                "servers",
                data,
            )
            if isinstance(data, dict)
            else data
        )

        if isinstance(servers, dict):
            names = [
                str(k)
                for k, v in servers.items()
                if isinstance(
                    v,
                    (dict, list, str)
                )
            ]

        elif isinstance(servers, list):
            for item in servers:
                if not isinstance(item, dict):
                    continue

                name = (
                    item.get("name")
                    or item.get("id")
                )

                if name:
                    names.append(str(name))

    return (
        path,
        sorted(set(names)),
    )


def configured_mcps():
    """MCP servers each account will actually load, read from config files.

    Claude 1 runs without CLAUDE_CONFIG_DIR (T3 default instance), so its
    config is ~/.claude.json. Claude 2 uses CLAUDE_CONFIG_DIR=~/.claude_second.
    claude.ai cloud connectors are account-side and not visible here.
    """

    result = {}

    for label, path in [
        ("Claude 1", H / ".claude.json"),
        ("Claude 2", H / ".claude_second" / ".claude.json"),
    ]:
        data = load_json(path, {})

        user = sorted(
            (data.get("mcpServers") or {}).keys()
        )

        projects = {
            name: len(cfg.get("mcpServers") or {})
            for name, cfg in (data.get("projects") or {}).items()
            if isinstance(cfg, dict) and cfg.get("mcpServers")
        }

        result[label] = {
            "path": path,
            "user": user,
            "projects": projects,
        }

    for label, home in [
        ("Codex 1", H / ".codex"),
        ("Codex 2", H / ".codex_second"),
    ]:
        path = home / "config.toml"

        try:
            data = load_toml(path)
        except Exception:
            data = {}

        result[label] = {
            "path": path,
            "user": sorted(
                name
                for name, cfg in (data.get("mcp_servers") or {}).items()
                if not (isinstance(cfg, dict) and cfg.get("enabled") is False)
            ),
            "projects": {},
            "shared_with": (
                str(path.resolve())
                if path.is_symlink()
                else None
            ),
        }

    return result


def plugin_inventory():
    """Installed/enabled plugin units, not raw plugin.json file counts.

    Recursive plugin.json counting over-reports: marketplace catalogs, version
    caches, .trash, per-host manifests (.claude-plugin/.codex-plugin/
    .cursor-plugin/...), stale ~gN generations and staging copies all match.
    """

    shared = A / "claude-plugins" / "shared"

    installed = load_json(
        shared / "installed_plugins.json",
        {},
    )

    installed = installed.get("plugins", installed)

    result = {
        "claude_installed": len(installed) if isinstance(installed, dict) else 0,
        "marketplace_catalog": count_plugins(shared / "marketplaces"),
    }

    for label, home in [
        ("Claude 1", H / ".claude"),
        ("Claude 2", H / ".claude_second"),
    ]:
        settings = load_json(home / "settings.json", {})

        result[f"{label} enabled"] = sum(
            1
            for v in (settings.get("enabledPlugins") or {}).values()
            if v
        )

        current = 0
        required = 0
        stale = 0

        for org in (home / "plugins" / "synced").glob("*"):
            if not org.is_dir():
                continue

            for meta in org.glob("*.meta.json"):
                if "~g" in meta.name:
                    stale += 1
                    continue

                current += 1

                if load_json(meta, {}).get("installation_preference") == "required":
                    required += 1

        result[f"{label} synced"] = (current, required, stale)

    for label, home in [
        ("Codex 1", H / ".codex"),
        ("Codex 2", H / ".codex_second"),
    ]:
        try:
            data = load_toml(home / "config.toml")
        except Exception:
            data = {}

        result[f"{label} enabled"] = sum(
            1
            for v in (data.get("plugins") or {}).values()
            if not isinstance(v, dict) or v.get("enabled", True)
        )

    return result


def agentos_services():
    return sorted(
        p.stem
        for p in (H / "Library" / "LaunchAgents").glob("com.agentos.*.plist")
    )


def sqlite_stats():
    path = (
        A
        / "v2"
        / "db"
        / "agentos.sqlite"
    )

    if not path.exists():
        return {
            "path": str(path),
            "available": False,
        }

    result = {
        "path": str(path),
        "available": True,
    }

    try:
        con = sqlite3.connect(path)
        con.row_factory = sqlite3.Row

        tables = {
            x["name"]
            for x in con.execute(
                "SELECT name FROM sqlite_master WHERE type='table'"
            ).fetchall()
        }

        result["tables"] = sorted(tables)

        if "tasks" in tables:
            result["tasks_total"] = con.execute(
                "SELECT COUNT(*) n FROM tasks"
            ).fetchone()["n"]

            try:
                result["tasks_running"] = con.execute(
                    "SELECT COUNT(*) n FROM tasks WHERE status='running'"
                ).fetchone()["n"]
            except Exception:
                result["tasks_running"] = "unknown"

            try:
                result["tasks_completed"] = con.execute(
                    "SELECT COUNT(*) n FROM tasks WHERE status='completed'"
                ).fetchone()["n"]
            except Exception:
                result["tasks_completed"] = "unknown"

        if "metrics" in tables:
            result["metrics"] = con.execute(
                "SELECT COUNT(*) n FROM metrics"
            ).fetchone()["n"]

        if "events" in tables:
            result["events"] = con.execute(
                "SELECT COUNT(*) n FROM events"
            ).fetchone()["n"]

        if "failures" in tables:
            result["failure_memories"] = con.execute(
                "SELECT COUNT(*) n FROM failures"
            ).fetchone()["n"]

        con.close()

    except Exception as exc:
        result["available"] = False
        result["error"] = str(exc)

    return result


def command_inventory():
    names = [
        "agent-v2",
        "agentos2",
        "agent-cap",
        "agent-models",
        "agent-model-governor",
        "agent-plugin-governor",
        "agent-proof",
        "agent-fail",
        "agent-guard",
        "agent-research",
        "agent-dashboard",
        "agent-handoff",
        "agent-upstream",
        "agent-plugins-sync",
        "agent-codex",
        "agent-ha",
        "codex-ha",
        "mcpall",
        "agent-doc-sync",
        "agent-system",
        "agent-system-change",
    ]

    return {
        name: shutil.which(name)
        for name in names
        if shutil.which(name)
    }


def service_state(label):
    rc, _ = run(
        [
            "launchctl",
            "print",
            f"gui/{os.getuid()}/{label}",
        ],
        timeout=5,
    )

    return "loaded" if rc == 0 else "not loaded"


def git_version():
    rc, out = run(
        ["git", "--version"]
    )

    return out.strip() if rc == 0 else "missing"


def tool_version(name, args):
    path = shutil.which(name)

    if not path:
        return "missing"

    rc, out = run(
        [path, *args],
        timeout=10,
    )

    if rc != 0:
        return "installed"

    return (
        out.strip()
        .splitlines()[0]
        if out.strip()
        else "installed"
    )


# Optional alias agents kept side by side with the canonical ones, e.g.
# ("agent-codex-worker", "acme-codex-worker", ["codex-ha ready", "75"]).
# They may be worded differently, so compare what matters: the frontmatter
# fields that change behavior and the rules each pair must both state.
AGENT_PAIRS = []
AGENT_FIELDS = ["tools", "model", "isolation"]


def agent_frontmatter(text):
    fields = {}
    if text.startswith("---"):
        for line in text.split("---", 2)[1].splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                fields[k.strip()] = v.strip()
    return fields


def agent_drift():
    result = []
    root = A / "team" / "agents"
    for a, b, rules in AGENT_PAIRS:
        try:
            ta = (root / f"{a}.md").read_text()
            tb = (root / f"{b}.md").read_text()
        except OSError as e:
            result.append(f"Agent pair {a}/{b}: {e}")
            continue
        fa, fb = agent_frontmatter(ta), agent_frontmatter(tb)
        for k in AGENT_FIELDS:
            if fa.get(k, "(inherit)") != fb.get(k, "(inherit)"):
                result.append(
                    f"Agent drift: {k} is {fa.get(k, '(inherit)')!r} in {a} "
                    f"but {fb.get(k, '(inherit)')!r} in {b}."
                )
        for rule in rules:
            missing = [n for n, t in ((a, ta), (b, tb)) if rule not in t]
            if len(missing) == 1:
                result.append(f"Agent drift: {missing[0]} lacks {rule!r}.")
            elif missing:
                result.append(f"Agent pair {a}/{b}: both lack {rule!r}.")
    return result


def warnings(shared_skills, luna, effort):
    result = agent_drift()

    for path in [
        H / ".claude" / "skills",
        H / ".claude_second" / "skills",
    ]:
        if not path.exists() and not path.is_symlink():
            result.append(
                f"{path} is missing."
            )
            continue

        if path.is_symlink():
            try:
                if path.resolve() != shared_skills.resolve():
                    result.append(
                        f"{path} points to {path.resolve()} instead of {shared_skills}."
                    )
            except Exception:
                result.append(
                    f"{path} is a broken symlink."
                )

    if luna == "unknown":
        result.append(
            "Current promoted Codex Luna could not be resolved."
        )

    if effort not in {"xhigh", "unknown"}:
        result.append(
            f"Codex reasoning effort appears to be {effort}; AgentOS policy expects xhigh."
        )

    for path in [
        H / ".claude" / "CLAUDE.md",
        H / ".claude_second" / "CLAUDE.md",
        H / ".codex" / "AGENTS.md",
        H / ".codex_second" / "AGENTS.md",
    ]:
        try:
            text = path.read_text(errors="ignore")

            if "AGENTOS_CANONICAL_BEGIN" not in text:
                result.append(
                    f"Canonical AgentOS reference missing from {path}."
                )

        except Exception:
            pass

    try:
        if "AGENTOS_DEVICE_GUIDANCE_BEGIN" not in (H / ".codex_second" / "AGENTS.md").read_text(errors="ignore"):
            result.append(
                f"Device guidance pointer missing from {H / '.codex_second' / 'AGENTS.md'} (Codex 2 would skip ~/.agent-os/policy/claude/AGENTS.md)."
            )
    except Exception:
        pass

    return result


CODEX_AGENTS = H / ".codex" / "AGENTS.md"
CLAUDE_AGENTS = A / "policy" / "claude" / "AGENTS.md"

# Blocks in ~/.codex/AGENTS.md that are Codex-only or already loaded in
# Claude another way: the rtk "always prefix" rule contradicts Claude's
# RTK.md (a hook rewrites commands), the context7 block repeats the
# server's own MCP instructions, and the AgentOS blocks repeat CLAUDE.md.
CODEX_ONLY_BLOCKS = [
    (r"<!-- rtk-instructions[^>]*-->", r"<!-- /rtk-instructions -->"),
    (r"<!-- context7 -->", r"<!-- context7 -->"),
    (r"<!-- AGENTOS_GLOBAL_BEGIN -->", r"<!-- AGENTOS_GLOBAL_END -->"),
    (r"<!-- AGENTOS_V2 -->", r"<!-- /AGENTOS_V2 -->"),
    (r"<!-- AGENTOS_CANONICAL_BEGIN -->", r"<!-- AGENTOS_CANONICAL_END -->"),
]


def sync_claude_agents():
    # Both Claude accounts @-include CLAUDE_AGENTS so they share the
    # user's engineering guidance without the Codex-only blocks.
    try:
        text = CODEX_AGENTS.read_text()
    except OSError:
        return "missing source"

    for begin, end in CODEX_ONLY_BLOCKS:
        text = re.sub(
            begin + r".*?" + end + r"\n?",
            "",
            text,
            flags=re.S,
        )

    text = re.sub(r"(?m)^@\S*/\.codex/RTK\.md\n?", "", text)
    text = re.sub(r"\n{3,}", "\n\n", text).strip()

    out = (
        "<!-- GENERATED by agent-doc-sync from ~/.codex/AGENTS.md; edit that file instead. -->\n\n"
        + text
        + "\n"
    )

    CLAUDE_AGENTS.parent.mkdir(parents=True, exist_ok=True)

    if CLAUDE_AGENTS.exists() and CLAUDE_AGENTS.read_text() == out:
        return "current"

    tmp = CLAUDE_AGENTS.with_suffix(".tmp")
    tmp.write_text(out)
    os.replace(tmp, CLAUDE_AGENTS)

    return "updated"


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--quiet",
        action="store_true",
    )

    parser.add_argument(
        "--check",
        action="store_true",
    )

    args = parser.parse_args()

    A.mkdir(
        parents=True,
        exist_ok=True,
    )

    shared_skills = (
        H
        / ".agents"
        / "skills"
    )

    luna, candidate, effort = (
        resolve_models()
    )

    c1_selector, c1_exact = (
        claude_model(
            H / ".claude"
        )
    )

    c2_selector, c2_exact = (
        claude_model(
            H / ".claude_second"
        )
    )

    mcp_path, mcps = (
        mcp_inventory()
    )

    task_stats = (
        sqlite_stats()
    )

    commands = (
        command_inventory()
    )

    disk = shutil.disk_usage(H)

    services = {
        label: service_state(label)
        for label in agentos_services()
    }

    configured = configured_mcps()

    plugins = plugin_inventory()

    warn = warnings(
        shared_skills,
        luna,
        effort,
    )

    claude_agents = sync_claude_agents()

    if claude_agents == "missing source":
        warn.append(f"{CODEX_AGENTS} is missing; Claude guidance adapter not generated.")

    include = "@" + str(CLAUDE_AGENTS).replace(str(H), "~")

    for md in (H / ".claude" / "CLAUDE.md", H / ".claude_second" / "CLAUDE.md"):
        try:
            body = md.read_text()
        except OSError:
            body = ""
        if include not in body:
            warn.append(f"{md} does not include {include}; Claude accounts may get different guidance.")

    free_gib = disk.free / (1024**3)

    if free_gib < 15:
        warn.append(
            f"Free disk is {free_gib:.1f} GiB (< 15 GiB). Builds, simulators and Codex sessions may fail; see `agent-storage` and IMPROVEMENTS.md."
        )

    for label, status in services.items():
        if status != "loaded":
            warn.append(
                f"LaunchAgent {label} has a plist but is not loaded; its job never runs."
            )

    configured_names = {
        name
        for info in configured.values()
        for name in info["user"]
    }

    unconfigured = [
        name
        for name in mcps
        if name not in configured_names
    ]

    if unconfigured:
        warn.append(
            "mcpall manifest entries not configured in any local account (may exist only as claude.ai connectors): "
            + ", ".join(unconfigured)
        )

    index = load_json(
        A / "capabilities" / "index-v3.json",
        {},
    )

    index_mcps = [
        str(m.get("name"))
        for m in index.get("mcps", [])
        if isinstance(m, dict)
    ]

    if index and (
        not index_mcps
        or any(
            n.lower() == "command_not_found"
            for n in index_mcps
        )
    ):
        warn.append(
            f"Capability index MCP list is invalid ({index_mcps or 'empty'}); `agent-cap recommend` cannot route MCPs."
        )

    lines = [
        "# AgentOS Live State",
        "",
        "> AUTO-GENERATED. DO NOT EDIT MANUALLY.",
        "> Run `agent-doc-sync` to regenerate this file.",
        "",
        f"Generated: `{datetime.now().astimezone().isoformat()}`",
        "",
        "## Canonical Documentation",
        "",
        f"- SYSTEM: `{A / 'SYSTEM.md'}`",
        f"- STATE: `{A / 'STATE.md'}`",
        f"- DECISIONS: `{A / 'DECISIONS.md'}`",
        f"- CHANGELOG: `{A / 'CHANGELOG.md'}`",
        f"- LESSONS: `{A / 'LESSONS.md'}`",
        f"- IMPROVEMENTS: `{A / 'IMPROVEMENTS.md'}`",
        f"- Claude audit prompt: `{A / 'PROMPT_FOR_CLAUDE.md'}`",
        "",
        "## Models",
        "",
        f"- Claude 1 selector: `{c1_selector}`",
        f"- Claude 1 exact Opus override: `{c1_exact or 'none / family alias'}`",
        f"- Claude 2 selector: `{c2_selector}`",
        f"- Claude 2 exact Opus override: `{c2_exact or 'none / family alias'}`",
        f"- Promoted Codex Luna: `{luna}`",
        f"- Codex Luna candidate: `{candidate}`",
        f"- Detected Codex reasoning effort: `{effort}`",
        f"- Required worker reasoning policy: `xhigh`",
        "",
        "## Account Homes",
        "",
        f"- Claude 1: `{H / '.claude'}` — {'present' if (H / '.claude').exists() else 'missing'}",
        f"- Claude 2: `{H / '.claude_second'}` — {'present' if (H / '.claude_second').exists() else 'missing'}",
        f"- Codex 1: `{H / '.codex'}` — {'present' if (H / '.codex').exists() else 'missing'}",
        f"- Codex 2: `{H / '.codex_second'}` — {'present' if (H / '.codex_second').exists() else 'missing'}",
        f"- Codex 1 auth file exists: `{'yes' if (H / '.codex' / 'auth.json').exists() else 'no'}`",
        f"- Codex 2 auth file exists: `{'yes' if (H / '.codex_second' / 'auth.json').exists() else 'no'}`",
        "",
        "## Shared Skills",
        "",
        f"- Canonical root: `{shared_skills}`",
        f"- Portable Skill count: `{count_skills()}`",
        f"- Claude 1 skills link: `{symlink_state(H / '.claude' / 'skills', shared_skills)}`",
        f"- Claude 2 skills link: `{symlink_state(H / '.claude_second' / 'skills', shared_skills)}`",
        "",
        "## Plugins",
        "",
        f"- Shared Claude local/user Plugins installed: `{plugins['claude_installed']}` (marketplace catalog entries, not installed: `{plugins['marketplace_catalog']}`)",
        f"- Claude 1 enabled local/user Plugins: `{plugins['Claude 1 enabled']}`",
        f"- Claude 2 enabled local/user Plugins: `{plugins['Claude 2 enabled']}`",
        f"- Claude 1 cloud-synced Plugins: `{plugins['Claude 1 synced'][0]}` (org-required: `{plugins['Claude 1 synced'][1]}`, stale generations: `{plugins['Claude 1 synced'][2]}`)",
        f"- Claude 2 cloud-synced Plugins: `{plugins['Claude 2 synced'][0]}` (org-required: `{plugins['Claude 2 synced'][1]}`, stale generations: `{plugins['Claude 2 synced'][2]}`)",
        f"- Codex 1 enabled Plugins (config.toml): `{plugins['Codex 1 enabled']}`",
        f"- Codex 2 enabled Plugins (config.toml): `{plugins['Codex 2 enabled']}`",
        "",
        "## MCP Servers",
        "",
        f"- mcpall manifest: `{mcp_path}` — `{len(mcps)}` entries",
    ]

    if mcps:
        lines.append(
            "- Manifest entries: "
            + ", ".join(f"`{n}`" for n in mcps)
        )

    lines.append(
        "- Configured per account (from config files; claude.ai connectors are account-side and not listed):"
    )

    for label, info in configured.items():
        extra = ""

        if info.get("shared_with"):
            extra += f" (config symlink → `{info['shared_with']}`)"

        if info["projects"]:
            extra += " + project-scoped: " + ", ".join(
                f"`{p}`={n}"
                for p, n in sorted(info["projects"].items())
            )

        lines.append(
            f"  - {label} `{info['path']}`: `{len(info['user'])}` — "
            + (", ".join(info["user"]) or "none")
            + extra
        )

    lines += [
        "",
        "## AgentOS v2 Durable State",
        "",
        f"- Database: `{task_stats.get('path')}`",
        f"- Database available: `{task_stats.get('available')}`",
    ]

    for key in [
        "tasks_total",
        "tasks_running",
        "tasks_completed",
        "metrics",
        "events",
        "failure_memories",
    ]:
        if key in task_stats:
            lines.append(
                f"- {key.replace('_', ' ').title()}: `{task_stats[key]}`"
            )

    lines += [
        "",
        "## Available AgentOS Commands",
        "",
    ]

    if commands:
        for name, path in sorted(
            commands.items()
        ):
            lines.append(
                f"- `{name}` → `{path}`"
            )
    else:
        lines.append(
            "- No AgentOS commands were discovered on PATH."
        )

    lines += [
        "",
        "## Background Services",
        "",
    ]

    for label, status in services.items():
        lines.append(
            f"- `{label}`: `{status}`"
        )

    lines += [
        "",
        "## Local Tooling",
        "",
        f"- Git: `{git_version()}`",
        f"- Claude CLI: `{tool_version('claude', ['--version'])}`",
        f"- Codex CLI: `{tool_version('codex', ['--version'])}`",
        f"- Python: `{tool_version('python3', ['--version'])}`",
        f"- Node: `{tool_version('node', ['--version'])}`",
        "",
        "## Disk",
        "",
        f"- Total: `{disk.total / (1024**3):.1f} GiB`",
        f"- Used: `{disk.used / (1024**3):.1f} GiB`",
        f"- Free: `{disk.free / (1024**3):.1f} GiB`",
        "",
        "## Canonical Policy",
        "",
        "- Claude lead: current Opus family.",
        "- Codex implementation workers: promoted Luna with xhigh reasoning.",
        "- Portable Skills: shared through `~/.agents/skills`.",
        "- Authentication: account-specific.",
        "- New models: candidate/canary before promotion when material.",
        "- Significant executable Plugin updates: inspect before acceptance.",
        "- Context: minimum sufficient + just-in-time retrieval.",
        "- Completion: proof over self-report.",
        "- Self-improvement: evidence-backed and reversible.",
        "",
        "## Warnings",
        "",
    ]

    if warn:
        for item in warn:
            lines.append(
                f"- ⚠️ {item}"
            )
    else:
        lines.append(
            "- No canonical configuration warnings detected by agent-doc-sync."
        )

    lines += [
        "",
        "## Source of Truth Rule",
        "",
        "If this generated file conflicts with actual executable configuration:",
        "",
        "> Inspect actual configuration, fix the discrepancy, then regenerate STATE.md.",
        "",
    ]

    text = "\n".join(lines)

    STATE.write_text(
        text + "\n"
    )

    if args.check and warn:
        print(
            text
        )
        raise SystemExit(2)

    if not args.quiet:
        print(
            text
        )


if __name__ == "__main__":
    main()
