#!/usr/bin/env python3

from __future__ import annotations

from pathlib import Path
from datetime import datetime
import argparse
import hashlib
import json
import os
import shutil
import subprocess


# AGENTOS_HOME redirects every path (tests run against a throwaway copy).
H = Path(os.environ.get("AGENTOS_HOME") or Path.home())
A = H / ".agent-os"
CHANGES = A / "changes"
SKILLS = H / ".agents" / "skills"
SKILL_SOURCES = H / ".agents" / "skill-sources.json"


def iso():
    return datetime.now().astimezone().isoformat()


def digest(path):
    path = Path(path)

    try:
        h = hashlib.sha256()

        with path.open("rb") as f:
            while True:
                chunk = f.read(
                    1024 * 1024
                )

                if not chunk:
                    break

                h.update(chunk)

        return h.hexdigest()

    except Exception:
        return ""


def save_json(path, obj):
    Path(path).write_text(
        json.dumps(
            obj,
            indent=2,
            ensure_ascii=False,
        )
        + "\n"
    )


def snapshot_files(change_dir):
    snapshot = (
        change_dir
        / "before"
    )

    snapshot.mkdir(
        parents=True,
        exist_ok=True,
    )

    candidates = [
        A / "SYSTEM.md",
        A / "STATE.md",
        A / "DECISIONS.md",
        A / "CHANGELOG.md",
        A / "LESSONS.md",
        A / "IMPROVEMENTS.md",
        A / "models.json",
        H / ".claude" / "settings.json",
        H / ".claude_second" / "settings.json",
        H / ".claude" / "CLAUDE.md",
        H / ".claude_second" / "CLAUDE.md",
        H / ".codex" / "config.toml",
        H / ".codex_second" / "config.toml",
        H / ".codex" / "AGENTS.md",
        H / ".codex_second" / "AGENTS.md",
    ]

    for p in (H / "bin").glob("agent*"):
        candidates.append(p)

    for name in [
        "codex-ha",
        "mcpall",
    ]:
        candidates.append(
            H / "bin" / name
        )

    seen = set()
    result = []

    for index, path in enumerate(
        candidates
    ):
        if not path.exists() and not path.is_symlink():
            continue

        try:
            resolved = path.resolve()
        except Exception:
            resolved = path

        key = str(resolved)

        if key in seen:
            continue

        seen.add(key)

        if not resolved.is_file():
            continue

        dst = (
            snapshot
            / (
                f"{index:03d}-"
                + resolved.name
            )
        )

        try:
            shutil.copy2(
                resolved,
                dst,
            )

            result.append(
                {
                    "source": str(path),
                    "resolved": str(resolved),
                    "backup": str(dst),
                    "sha256": digest(resolved),
                }
            )

        except Exception:
            pass

    return result


def append(path, text):
    path = Path(path)

    with path.open("a") as f:
        f.write(
            "\n"
            + text.rstrip()
            + "\n"
        )


def validity_lines(valid_from, invalid_at, supersedes, prefix):
    """Optional validity fields parsed by agent-recall. Valid from defaults to today;
    Invalid at / Supersedes are written only when given. Entries without them stay valid.
    Supersedes IDs go to the entry of the same type (ADR-* to the ADR, L-* to the lesson);
    IDs with another prefix go to both."""
    supersedes = ", ".join(
        x
        for x in (
            y.strip()
            for y in supersedes.replace(";", ",").split(",")
        )
        if x
        and (
            x.startswith(prefix)
            or not x.startswith(("ADR-", "L-"))
        )
    )

    lines = [
        "Valid from: "
        + (valid_from or datetime.now().strftime("%Y-%m-%d"))
    ]

    if invalid_at:
        lines.append(
            "Invalid at: " + invalid_at
        )

    if supersedes:
        lines.append(
            "Supersedes: " + supersedes
        )

    return "\n\n".join(lines)


def run_sync():
    exe = (
        H
        / "bin"
        / "agent-doc-sync"
    )

    if not exe.exists():
        return

    subprocess.run(
        [
            str(exe),
            "--quiet",
        ],
        check=False,
    )


def skill_hash_snapshot():
    """sha256 of every shared SKILL.md, recorded at begin so finish can tell
    which skills this change edited."""
    out = {}

    if not SKILLS.is_dir():
        return out

    for d in sorted(SKILLS.iterdir()):
        f = d / "SKILL.md"

        if f.is_file():
            out[d.name] = digest(f)

    return out


def write_sources(data):
    text = json.dumps(
        data,
        indent=2,
        ensure_ascii=False,
    ) + "\n"

    json.loads(text)

    tmp = SKILL_SOURCES.with_name(
        "." + SKILL_SOURCES.name + f".tmp-{os.getpid()}"
    )

    tmp.write_text(text)

    try:
        os.chmod(tmp, SKILL_SOURCES.stat().st_mode & 0o7777)
    except Exception:
        pass

    os.replace(tmp, SKILL_SOURCES)

    json.loads(SKILL_SOURCES.read_text())


def changed_during(name, path, manifest):
    snap = manifest.get("skill_hashes")

    if isinstance(snap, dict):
        return snap.get(name) != digest(path)

    # Changes begun before snapshots existed: fall back to mtime vs start.
    try:
        started = datetime.fromisoformat(
            manifest.get("started_at", "")
        ).timestamp()
    except Exception:
        return False

    try:
        return path.stat().st_mtime >= started
    except Exception:
        return False


def reconcile_skill_hashes(cid, manifest):
    """Device-local skills (source has no upstream repository) edited during
    this change get installed_sha256 refreshed. Upstream-sourced skills whose
    SKILL.md no longer matches the record only produce a warning."""
    report = {
        "refreshed": [],
        "warnings": [],
    }

    try:
        data = json.loads(SKILL_SOURCES.read_text())
    except Exception as e:
        if SKILL_SOURCES.exists():
            report["warnings"].append(
                f"cannot read {SKILL_SOURCES}: {e}"
            )
        return report

    dirty = False

    for src in data.get("sources", []):
        reviews = src.get("skill_reviews")

        if not isinstance(reviews, dict):
            continue

        local = not src.get("repository")

        for name, review in reviews.items():
            if not isinstance(review, dict):
                continue

            recorded = review.get("installed_sha256")
            path = SKILLS / name / "SKILL.md"

            if not recorded or not path.is_file():
                continue

            current = digest(path)

            if current == recorded:
                continue

            during = changed_during(name, path, manifest)

            if local and during:
                review["installed_sha256"] = current
                review["installed_sha256_updated_at"] = iso()
                review["installed_sha256_change"] = cid
                dirty = True

                report["refreshed"].append(
                    {
                        "skill": name,
                        "source": src.get("id"),
                        "old": recorded,
                        "new": current,
                    }
                )

            elif local:
                report["warnings"].append(
                    f"{name} ({src.get('id')}): device-local SKILL.md differs from "
                    f"installed_sha256 but was not edited during {cid}; not refreshed. "
                    f"If the edit was sanctioned: agent-system-change rehash {name} --change <id>"
                )

            else:
                report["warnings"].append(
                    f"{name} ({src.get('id')}): upstream-sourced SKILL.md differs from "
                    f"installed_sha256 ({'edited during this change' if during else 'edited outside this change'}); "
                    "not auto-refreshed. Review the diff against upstream, then "
                    f"agent-system-change rehash {name} --change <id>"
                )

    if dirty:
        write_sources(data)

    return report


def rehash(skills, change, note):
    if not (CHANGES / change / "manifest.json").exists():
        raise SystemExit(f"Unknown change ID: {change}")

    data = json.loads(SKILL_SOURCES.read_text())
    found = set()

    for src in data.get("sources", []):
        reviews = src.get("skill_reviews")

        if not isinstance(reviews, dict):
            continue

        for name in skills:
            review = reviews.get(name)
            path = SKILLS / name / "SKILL.md"

            if not isinstance(review, dict) or not path.is_file():
                continue

            found.add(name)
            current = digest(path)
            old = review.get("installed_sha256")

            if old == current:
                print(f"= {name}: installed_sha256 already current ({current[:12]})")
                continue

            review["installed_sha256"] = current
            review["installed_sha256_updated_at"] = iso()
            review["installed_sha256_change"] = change

            if note:
                review["installed_sha256_note"] = note

            print(f"~ {name}: installed_sha256 {str(old)[:12]} -> {current[:12]} (change {change})")

    missing = [x for x in skills if x not in found]

    if found:
        write_sources(data)

    if missing:
        raise SystemExit(
            "No skill_reviews entry or SKILL.md for: " + ", ".join(missing)
        )


def begin(goal):
    CHANGES.mkdir(
        parents=True,
        exist_ok=True,
    )

    stamp = datetime.now().strftime(
        "%Y%m%d-%H%M%S"
    )

    short = hashlib.sha256(
        goal.encode()
    ).hexdigest()[:6]

    cid = (
        stamp
        + "-"
        + short
    )

    directory = (
        CHANGES
        / cid
    )

    directory.mkdir(
        parents=True,
        exist_ok=False,
    )

    run_sync()

    before_state = (
        A
        / "STATE.md"
    )

    if before_state.exists():
        shutil.copy2(
            before_state,
            directory
            / "STATE.before.md",
        )

    files = snapshot_files(
        directory
    )

    manifest = {
        "id": cid,
        "status": "started",
        "started_at": iso(),
        "goal": goal,
        "backup_files": files,
        "skill_hashes": skill_hash_snapshot(),
    }

    save_json(
        directory
        / "manifest.json",
        manifest,
    )

    append(
        A / "CHANGELOG.md",
        f"""## {iso()} — AgentOS change started

Change ID: `{cid}`

Goal:

{goal}

Status: In progress

Backup:

`{directory / 'before'}`
""",
    )

    print(cid)


def skill_hash_note(report):
    lines = []

    for item in report.get("refreshed", []):
        lines.append(
            f"- refreshed installed_sha256 for {item['skill']} "
            f"({item['old'][:12]} -> {item['new'][:12]})"
        )

    for warning in report.get("warnings", []):
        lines.append("- warning: " + warning)

    if not lines:
        return ""

    return "\nSkill provenance:\n\n" + "\n".join(lines) + "\n"


def finish(
    cid,
    summary,
    evidence,
    decision,
    lesson,
    improvement,
    valid_from="",
    invalid_at="",
    supersedes="",
):
    directory = (
        CHANGES
        / cid
    )

    manifest_path = (
        directory
        / "manifest.json"
    )

    if not manifest_path.exists():
        raise SystemExit(
            f"Unknown change ID: {cid}"
        )

    manifest = json.loads(
        manifest_path.read_text()
    )

    skills_report = reconcile_skill_hashes(
        cid,
        manifest,
    )

    for item in skills_report["refreshed"]:
        print(
            f"~ refreshed installed_sha256 for device-local skill {item['skill']}: "
            f"{item['old'][:12]} -> {item['new'][:12]}"
        )

    for warning in skills_report["warnings"]:
        print(f"⚠️  {warning}")

    run_sync()

    state = (
        A
        / "STATE.md"
    )

    if state.exists():
        shutil.copy2(
            state,
            directory
            / "STATE.after.md",
        )

    manifest.update(
        {
            "status": "finished",
            "finished_at": iso(),
            "summary": summary,
            "evidence": evidence,
            "decision": decision,
            "lesson": lesson,
            "improvement": improvement,
            "skill_hash_reconcile": skills_report,
        }
    )

    save_json(
        manifest_path,
        manifest,
    )

    append(
        A / "CHANGELOG.md",
        f"""## {iso()} — AgentOS change finished

Change ID: `{cid}`

Goal:

{manifest.get('goal', '')}

Summary:

{summary}

Evidence:

{evidence or 'Not provided'}

Status: Completed
{skill_hash_note(skills_report)}
Rollback snapshot:

`{directory / 'before'}`
""",
    )

    if decision:
        append(
            A / "DECISIONS.md",
            f"""## ADR-{datetime.now().strftime('%Y%m%d%H%M%S')} — {summary}

Status: Accepted

Date: {iso()}

{validity_lines(valid_from, invalid_at, supersedes, "ADR-")}

Context:

{manifest.get('goal', '')}

Decision:

{decision}

Evidence:

{evidence or 'See linked AgentOS change record.'}

Rollback:

Backup available at:

`{directory / 'before'}`
""",
        )

    if lesson:
        append(
            A / "LESSONS.md",
            f"""## L-{datetime.now().strftime('%Y%m%d%H%M%S')} — AgentOS Change Lesson

Date: {iso()}

{validity_lines(valid_from, invalid_at, supersedes, "L-")}

Change:

{summary}

Durable lesson:

{lesson}

Evidence:

{evidence or 'See linked AgentOS change record.'}
""",
        )

    if improvement:
        append(
            A / "IMPROVEMENTS.md",
            f"""## IMP-{datetime.now().strftime('%Y%m%d%H%M%S')} — Proposed Improvement

Status: Proposed

Date: {iso()}

Observed context:

{summary}

Hypothesis:

{improvement}

Evidence so far:

{evidence or 'Insufficient evidence yet.'}

Next step:

Design a bounded representative experiment before global promotion.
""",
        )

    run_sync()

    print(
        f"✅ AgentOS change {cid} finalized."
    )

    print(
        f"Record: {manifest_path}"
    )


def status(cid):
    path = (
        CHANGES
        / cid
        / "manifest.json"
    )

    if not path.exists():
        raise SystemExit(
            f"Unknown change ID: {cid}"
        )

    print(
        path.read_text()
    )


def main():
    parser = argparse.ArgumentParser(
        prog="agent-system-change"
    )

    sub = parser.add_subparsers(
        dest="cmd",
        required=True,
    )

    start = sub.add_parser(
        "begin"
    )

    start.add_argument(
        "goal"
    )

    done = sub.add_parser(
        "finish"
    )

    done.add_argument(
        "change_id"
    )

    done.add_argument(
        "summary"
    )

    done.add_argument(
        "--evidence",
        default="",
    )

    done.add_argument(
        "--decision",
        default="",
    )

    done.add_argument(
        "--lesson",
        default="",
    )

    done.add_argument(
        "--improvement",
        default="",
    )

    done.add_argument(
        "--valid-from",
        default="",
        help="YYYY-MM-DD the ADR/lesson applies from (default: today)",
    )

    done.add_argument(
        "--invalid-at",
        default="",
        help="YYYY-MM-DD after which the ADR/lesson no longer applies",
    )

    done.add_argument(
        "--supersedes",
        default="",
        help="IDs this ADR/lesson replaces, e.g. 'ADR-0005, L-0003'",
    )

    rh = sub.add_parser(
        "rehash",
        help="record the current SKILL.md sha256 as installed_sha256 for sanctioned edits",
    )

    rh.add_argument(
        "skills",
        nargs="+",
    )

    rh.add_argument(
        "--change",
        required=True,
        help="change ID that sanctioned the edit",
    )

    rh.add_argument(
        "--note",
        default="",
    )

    show = sub.add_parser(
        "status"
    )

    show.add_argument(
        "change_id"
    )

    args = parser.parse_args()

    if args.cmd == "begin":
        begin(
            args.goal
        )

    elif args.cmd == "finish":
        finish(
            args.change_id,
            args.summary,
            args.evidence,
            args.decision,
            args.lesson,
            args.improvement,
            args.valid_from,
            args.invalid_at,
            args.supersedes,
        )

    elif args.cmd == "rehash":
        rehash(
            args.skills,
            args.change,
            args.note,
        )

    elif args.cmd == "status":
        status(
            args.change_id
        )


if __name__ == "__main__":
    main()
