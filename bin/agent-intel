def now():
    return datetime.now().astimezone().isoformat()


def ensure_dirs():
    for p in [
        CAP_DIR,
        STATE_DIR,
        TEL_DIR,
        PROJ_DIR,
        PROOF_DIR,
        VENDOR_DIR,
    ]:
        p.mkdir(
            parents=True,
            exist_ok=True,
        )


def run(
    cmd,
    *,
    env=None,
    cwd=None,
    timeout=45,
    shell=False,
):
    try:
        p = subprocess.run(
            cmd,
            env=env,
            cwd=cwd,
            text=True,
            capture_output=True,
            timeout=timeout,
            shell=shell,
        )

        return (
            p.returncode,
            (p.stdout or "")
            + (p.stderr or ""),
        )

    except subprocess.TimeoutExpired as e:
        out = (
            e.stdout
            if isinstance(
                e.stdout,
                str,
            )
            else ""
        )

        return (
            124,
            out + "\nTIMEOUT",
        )

    except FileNotFoundError:
        return (
            127,
            "COMMAND_NOT_FOUND",
        )

    except Exception as e:
        return (
            1,
            f"{type(e).__name__}: {e}",
        )


def jload(path, default):
    try:
        return json.loads(
            Path(path).read_text()
        )

    except Exception:
        return default


def jsave(path, data):
    p = Path(path)

    p.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    tmp = p.with_name(
        p.name + ".tmp"
    )

    tmp.write_text(
        json.dumps(
            data,
            indent=2,
            ensure_ascii=False,
        )
        + "\n"
    )

    tmp.replace(p)


def tokens(text):
    return set(
        re.findall(
            r"[A-Za-z][A-Za-z0-9+_.-]{2,}|[\u0600-\u06FF]{3,}",
            (text or "").lower(),
        )
    )


def parse_frontmatter(path):
    try:
        text = Path(path).read_text(
            errors="ignore"
        )

    except Exception:
        return {}, ""

    lines = text.splitlines()

    if (
        not lines
        or lines[0].strip() != "---"
    ):
        return {}, text

    try:
        end = next(
            i
            for i in range(
                1,
                len(lines),
            )
            if lines[i].strip()
            == "---"
        )

    except StopIteration:
        return {}, text

    fm_lines = lines[1:end]
    data = {}

    i = 0

    key_re = re.compile(
        r"^([A-Za-z0-9_-]+):(?:\s*(.*))?$"
    )

    while i < len(fm_lines):
        line = fm_lines[i]
        m = key_re.match(line)

        if not m:
            i += 1
            continue

        key = m.group(1)

        raw = (
            m.group(2)
            or ""
        ).strip()

        if raw in {
            "|",
            ">",
            "|-",
            ">-",
            "|+",
            ">+",
        }:
            style = raw[0]
            buf = []

            i += 1

            while i < len(fm_lines):
                nxt = fm_lines[i]

                if (
                    key_re.match(nxt)
                    and not nxt.startswith(
                        (
                            " ",
                            "\t",
                        )
                    )
                ):
                    break

                if nxt.startswith(
                    (
                        " ",
                        "\t",
                    )
                ):
                    buf.append(
                        nxt.lstrip()
                    )

                elif not nxt.strip():
                    buf.append("")

                else:
                    break

                i += 1

            if style == "|":
                val = "\n".join(
                    buf
                ).strip()

            else:
                val = " ".join(
                    x.strip()
                    for x in buf
                    if x.strip()
                ).strip()

            data[key] = val

            continue

        val = raw

        if (
            len(val) >= 2
            and val[0] == val[-1]
            and val[0] in {
                "'",
                '"',
            }
        ):
            val = val[1:-1]

        data[key] = val
        i += 1

    body = "\n".join(
        lines[end + 1:]
    )

    return data, body


# Present on disk but not loaded by Claude Code or Codex: plugin
# marketplace catalogs (uninstalled), trashed plugins, and claude.ai
# org-synced plugins. Indexing them made agent-cap recommend skills a
# session cannot use (1,609 indexed vs ~200 loadable on 2026-10-08).
NOT_LOADED_DIRS = {
    "marketplaces",
    ".trash",
    "synced",
}


def walk_named(
    root,
    wanted,
):
    root = Path(root)

    if not root.exists():
        return

    seen = set()

    for cur, dirs, files in os.walk(
        root,
        followlinks=True,
    ):
        try:
            real = os.path.realpath(
                cur
            )

            st = os.stat(real)

            inode = (
                st.st_dev,
                st.st_ino,
            )

            if inode in seen:
                dirs[:] = []
                continue

            seen.add(inode)

        except Exception:
            pass

        dirs[:] = [
            d
            for d in dirs
            if d not in {
                ".git",
                "node_modules",
                ".build",
                "DerivedData",
            }
            | NOT_LOADED_DIRS
        ]

        for name in wanted:
            if name in files:
                yield (
                    Path(cur)
                    / name
                )


def source_roots():
    return [
        (
            "user-skills",
            HOME
            / ".agents"
            / "skills",
            set(ALL_ACCOUNTS),
        ),

        (
            "claude1-plugins",
            HOME
            / ".claude"
            / "plugins",
            {"claude1"},
        ),

        (
            "claude2-plugins",
            HOME
            / ".claude_second"
            / "plugins",
            {"claude2"},
        ),

        (
            "claude-shared-plugins",
            BASE
            / "claude-plugins"
            / "shared",
            {
                "claude1",
                "claude2",
            },
        ),

        (
            "codex1-plugins",
            HOME
            / ".codex"
            / "plugins",
            {"codex1"},
        ),

        (
            "codex2-plugins",
            HOME
            / ".codex_second"
            / "plugins",
            {"codex2"},
        ),
    ]


def merge_cap(
    store,
    key,
    item,
):
    if key not in store:
        store[key] = item
        return

    old = store[key]

    old["available_on"] = sorted(
        set(
            old.get(
                "available_on",
                [],
            )
        )
        | set(
            item.get(
                "available_on",
                [],
            )
        )
    )

    old["paths"] = sorted(
        set(
            old.get(
                "paths",
                [],
            )
        )
        | set(
            item.get(
                "paths",
                [],
            )
        )
    )

    if len(
        item.get(
            "description",
            "",
        )
    ) > len(
        old.get(
            "description",
            "",
        )
    ):
        old["description"] = (
            item["description"]
        )

    old["keywords"] = sorted(
        set(
            old.get(
                "keywords",
                [],
            )
        )
        | set(
            item.get(
                "keywords",
                [],
            )
        )
    )[:220]


def scan_skills():
    store = {}

    for (
        label,
        root,
        accounts,
    ) in source_roots():

        for p in (
            walk_named(
                root,
                {"SKILL.md"},
            )
            or []
        ):
            fm, body = (
                parse_frontmatter(p)
            )

            name = (
                fm.get("name")
                or p.parent.name
            ).strip()

            desc = (
                fm.get(
                    "description"
                )
                or ""
            ).strip()

            txt = (
                f"{name} "
                f"{desc} "
                f"{body[:2500]}"
            )

            item = {
                "kind":
                    "skill",

                "name":
                    name,

                "description":
                    desc,

                "available_on":
                    sorted(accounts),

                "paths":
                    [str(p)],

                "source":
                    label,

                "keywords":
                    sorted(
                        tokens(txt)
                    )[:220],
            }

            merge_cap(
                store,
                "skill:"
                + name.lower(),
                item,
            )

    return sorted(
        store.values(),
        key=lambda x:
            x["name"].lower(),
    )


def scan_plugins():
    store = {}

    for (
        label,
        root,
        accounts,
    ) in source_roots():

        root = Path(root)

        if not root.exists():
            continue

        for cur, dirs, files in os.walk(
            root,
            followlinks=True,
        ):
            dirs[:] = [
                d
                for d in dirs
                if d not in {
                    ".git",
                    "node_modules",
                    ".build",
                    "DerivedData",
                }
                | NOT_LOADED_DIRS
            ]

            if (
                "plugin.json"
                not in files
            ):
                continue

            parent_name = (
                Path(cur).name
            )

            if parent_name not in {
                ".claude-plugin",
                ".codex-plugin",
            }:
                continue

            p = (
                Path(cur)
                / "plugin.json"
            )

            data = jload(
                p,
                {},
            )

            name = str(
                data.get(
                    "name"
                )
                or p.parent.parent.name
            )

            interface = (
                data.get(
                    "interface",
                    {},
                )
                if isinstance(
                    data,
                    dict,
                )
                else {}
            )

            desc = str(
                data.get(
                    "description"
                )
                or interface.get(
                    "shortDescription",
                    "",
                )
                or ""
            )

            item = {
                "kind":
                    "plugin",

                "name":
                    name,

                "description":
                    desc,

                "available_on":
                    sorted(accounts),

                "paths":
                    [str(p)],

                "source":
                    label,

                "keywords":
                    sorted(
                        tokens(
                            name
                            + " "
                            + desc
                        )
                    )[:160],
            }

            merge_cap(
                store,
                "plugin:"
                + name.lower(),
                item,
            )

    return sorted(
        store.values(),
        key=lambda x:
            x["name"].lower(),
    )


def parse_mcp_lines(out):
    names = set()

    for raw in out.splitlines():
        line = raw.strip()

        if not line:
            continue

        if line.lower().startswith(
            (
                "name ",
                "checking ",
                "mcp ",
            )
        ):
            continue

        head = re.split(
            r"\s{2,}|\t|:",
            line,
            maxsplit=1,
        )[0].strip()

        if (
            head
            and len(head) <= 80
            and not head.startswith(
                (
                    "http",
                    "-",
                    "=",
                )
            )
        ):
            names.add(
                head.lower()
                .replace(
                    " ",
                    "-",
                )
            )

    return names


def configured_mcp_names(account, meta):
    # T3's default Claude instance (account 1) runs without
    # CLAUDE_CONFIG_DIR, so its MCP config is ~/.claude.json;
    # account 2 runs with CLAUDE_CONFIG_DIR=~/.claude_second.
    # claude.ai cloud connectors are account-side and not listed here.
    try:
        if meta["kind"] == "claude":
            path = (
                HOME / ".claude.json"
                if account == "claude1"
                else meta["home"] / ".claude.json"
            )

            servers = (
                json.loads(path.read_text())
                .get("mcpServers")
                or {}
            )

        else:
            text = (meta["home"] / "config.toml").read_text()

            try:
                import tomllib

                servers = (
                    tomllib.loads(text).get("mcp_servers")
                    or {}
                )

            except ImportError:
                # /usr/bin/python3 (3.9) under launchd has no tomllib:
                # top-level [mcp_servers.<name>] tables are enough here.
                servers = {
                    m.group(2): {}
                    for m in re.finditer(
                        r'^\[mcp_servers\.("?)([^".\]]+)\1\]\s*$',
                        text,
                        re.M,
                    )
                }

    except Exception:
        return 1, set()

    return 0, {
        str(name).lower()
        for name, cfg in servers.items()
        if not (
            isinstance(cfg, dict)
            and cfg.get("enabled") is False
        )
    }


def scan_mcps():
    store = {}

    for (
        account,
        meta,
    ) in ACCOUNTS.items():

        # Read the config each account actually loads instead of parsing
        # `claude/codex mcp list`, which health-checks every server (20-40s),
        # needs claude/codex on PATH (launchd has neither), and emits status
        # words that the line parser mistook for server names.
        rc, names = configured_mcp_names(
            account,
            meta,
        )

        for name in names:
            key = (
                f"mcp:{name}"
            )

            item = store.setdefault(
                key,
                {
                    "kind":
                        "mcp",

                    "name":
                        name,

                    "description":
                        "",

                    "available_on":
                        [],

                    "paths":
                        [],

                    "source":
                        "config",

                    "keywords":
                        sorted(
                            tokens(
                                name
                                + " "
                                + " ".join(
                                    MCP_HINTS.get(
                                        name,
                                        [],
                                    )
                                )
                            )
                        ),
                },
            )

            item[
                "available_on"
            ] = sorted(
                set(
                    item[
                        "available_on"
                    ]
                )
                | {account}
            )

            item.setdefault(
                "status",
                {},
            )[account] = (
                "ready"
                if rc == 0
                else "unknown"
            )

    return sorted(
        store.values(),
        key=lambda x:
            x["name"],
    )


def scan_tools():
    names = [
        "git",
        "gh",
        "node",
        "npm",
        "npx",
        "pnpm",
        "yarn",
        "bun",
        "python3",
        "uv",
        "ruby",
        "java",
        "flutter",
        "dart",
        "swift",
        "xcodebuild",
        "docker",
        "kubectl",
        "terraform",
        "aws",
        "az",
        "gcloud",
        "ollama",
        "ffmpeg",
        "brew",
        "cargo",
        "rustc",
        "go",
        "gradle",
    ]

    return {
        n:
            shutil.which(n)

        for n in names

        if shutil.which(n)
    }


def cap_refresh(
    quiet=False,
):
    ensure_dirs()

    data = {
        "version":
            3,

        "generated_at":
            now(),

        "accounts": {
            k: {
                "kind":
                    v["kind"],

                "home":
                    str(
                        v["home"]
                    ),
            }

            for k, v
            in ACCOUNTS.items()
        },

        "skills":
            scan_skills(),

        "plugins":
            scan_plugins(),

        "mcps":
            scan_mcps(),

        "tools":
            scan_tools(),
    }

    jsave(
        INDEX,
        data,
    )

    if not quiet:
        print(
            "AgentOS Capability "
            "Index v3"
        )

        print(
            "Skills :",
            len(
                data["skills"]
            ),
        )

        print(
            "Plugins:",
            len(
                data["plugins"]
            ),
        )

        print(
            "MCPs   :",
            len(
                data["mcps"]
            ),
        )

        print(
            "Tools  :",
            len(
                data["tools"]
            ),
        )

    return data


def hist_boost(
    kind,
    name,
):
    stats = jload(
        STATS,
        {},
    )

    row = stats.get(
        f"{kind}:{name.lower()}",
        {},
    )

    ok = int(
        row.get(
            "success",
            0,
        )
    )

    fail = int(
        row.get(
            "failure",
            0,
        )
    )

    uses = ok + fail

    if uses == 0:
        return 0.0

    rate = (
        (ok + 1)
        / (uses + 2)
    )

    return (
        rate * 5.0
        + min(
            2.0,
            math.log1p(uses),
        )
    )


# Ranking, rewritten 2026-10-08 after the cap-router eval scored plain
# token overlap at 11/24: generic words matched anything, so "write an email"
# got an ads skill and Gmail. Now: stop-words removed, rare words weigh more
# (IDF), name matches beat description matches, skills for a different stack
# than the task's are demoted, and account-connected MCPs are only suggested
# when the task names the service. Eval: ~/.agent-os/evals/cap-router.
STOP = set("""
a an and are as at be by can do does for from get got has have how i in into
is it its make me my need new of on or our please should so some that the
their them then this to up use using want we what when where which while who
why will with without would you your add fix write create build update change
run set check help app apps project work task tasks thing things
""".split())

STACKS = {
    "flutter": {"flutter", "dart"},
    "apple": {"swift", "swiftui", "ios", "iphone", "ipad", "xcode", "macos",
              "watchos", "visionos", "testflight", "uikit", "appkit"},
    "android": {"android", "kotlin", "compose", "jetpack", "gradle"},
    "web": {"react", "next.js", "nextjs", "vue", "html", "css", "browser",
            "playwright", "web", "webapp"},
}

STACK_MCPS = {"flutter": "dart", "apple": "xcode"}

# MCPs that act on a connected account are suggested only by name (or the
# service's everyday name), never by generic words like "email" or "file".
MCP_NAMES = {
    "google-calendar": ["calendar", "google calendar"],
    "google-drive": ["google drive", "my drive"],
    "huggingface": ["hugging face", "huggingface"],
}


def stem(t):
    for suf in ("ing", "ies", "es", "ed", "s"):
        if len(t) > len(suf) + 3 and t.endswith(suf):
            return t[: -len(suf)] + ("y" if suf == "ies" else "")
    return t


def rank_tokens(text):
    words = re.findall(r"[a-z][a-z0-9+]*(?:\.[a-z]+)?|[\u0600-\u06FF]{3,}",
                       (text or "").lower())
    out = set()
    for w in words:
        if w in STOP or len(w) < 2:
            continue
        out.add(stem(w))
    return out


def stacks_of(toks):
    return {k for k, v in STACKS.items() if toks & {stem(x) for x in v}}


def item_doc(item):
    name = rank_tokens(item["name"].replace("-", " ").replace("_", " "))
    desc = rank_tokens(item.get("description", "") + " "
                       + " ".join(item.get("keywords", [])))
    return name, desc


def idf_table(items):
    df = {}
    for it in items:
        name, desc = item_doc(it)
        for t in name | desc:
            df[t] = df.get(t, 0) + 1
    n = len(items) or 1
    return {t: math.log((n + 1) / (c + 1)) + 0.1 for t, c in df.items()}


def hint_hit(hint, low):
    return re.search(r"(?<![a-z0-9])" + re.escape(hint.lower()) + r"(?![a-z0-9])", low)


def score_item(item, task_tokens, task_text, idf=None, task_stacks=frozenset()):
    low = task_text.lower()
    if item["kind"] == "mcp":
        name = item["name"].lower()
        score = 0.0
        names = [name, name.replace("-", " ")] + MCP_NAMES.get(name, [])
        if any(hint_hit(n, low) for n in names):
            score += 10.0
        elif name not in PRIVATE_MCPS:
            if any(hint_hit(h, low) for h in MCP_HINTS.get(name, [])):
                score += 6.0
        if score and any(STACK_MCPS.get(s) == name for s in task_stacks):
            score += 2.0
        return score + (hist_boost(item["kind"], item["name"]) if score else 0.0)

    idf = idf or {}
    name, desc = item_doc(item)
    # Name hits weigh by how much of the name the task covers: "page" alone
    # must not pull privacy-legal-pages into a Next.js page bug (2026-10-10,
    # holdout3.json 24/36 -> 27/36, older sets unchanged or better).
    cover = len(task_tokens & name) / len(name) if name else 0.0
    score = 0.0
    for t in task_tokens:
        w = idf.get(t, 0.0)
        if t in name:
            score += 3.0 * w * cover
        elif t in desc:
            score += w / (1 + len(desc) / 120) ** 0.5
    if not score:
        return 0.0
    item_stacks = stacks_of(name | desc)
    if task_stacks and item_stacks:
        score *= 1.5 if task_stacks & item_stacks else 0.2
    # Usage history reorders relevant items; it can't make an item relevant.
    if score < MIN_SCORE:
        return 0.0
    return score + hist_boost(item["kind"], item["name"])


DOMAIN_WORDS = [
    ("engineering", """code coding bug crash repo repository ios android swift
     swiftui flutter dart kotlin compose jetpack xcode typescript javascript
     python node api frontend backend refactor test unit build compile
     database sql supabase postgres playwright next.js nextjs react deploy
     performance migrate migration layout sentry entitlement signing
     كود تطبيق برمجة ريبو فرونتاند باكند"""),
    ("data", """spreadsheet csv excel chart funnel analytics metric dashboard
     analyze analysis kpi revenue posthog retention cohort جدول تحليلات"""),
    ("document", """pdf docx document contract presentation slide deck report
     clause memo ملف عرض"""),
    ("research", """research compare comparison study benchmark evaluate survey
     بحث دراسة مقارنة"""),
    ("writing", """email letter post linkedin blog copy draft tweet newsletter
     announcement caption رسالة"""),
    ("design", "design ui ux figma canva mockup wireframe تصميم واجهة"),
]
DOMAIN_SETS = [(d, {stem(w) for w in words.split()}) for d, words in DOMAIN_WORDS]


def classify(task):
    tt = rank_tokens(task)
    best, best_n = "general", 0
    for domain, words in DOMAIN_SETS:
        n = len(tt & words)
        if n > best_n:
            best, best_n = domain, n

    n = len(task)
    complexity = "simple" if n < 90 else "normal" if n < 450 else "complex"
    return best, complexity


MIN_SCORE = 6.0


def current_mode():
    try:
        return (
            MODE_FILE
            .read_text()
            .strip()
        )

    except Exception:
        return "owner"


def cap_recommend(task):
    data = (
        jload(
            INDEX,
            None,
        )
        or cap_refresh(True)
    )

    mode = current_mode()

    tt = rank_tokens(task)
    task_stacks = stacks_of(tt)

    (
        domain,
        complexity,
    ) = classify(task)

    limits = {
        "simple":
            (1, 1, 1),

        "normal":
            (3, 2, 2),

        "complex":
            (5, 3, 4),
    }

    (
        skill_limit,
        plugin_limit,
        mcp_limit,
    ) = limits[complexity]

    def ranked(
        items,
        limit,
    ):
        rows = []
        idf = idf_table(items)

        for item in items:
            if (
                mode == "guest"
                and item["kind"]
                    == "mcp"
                and item["name"]
                    in PRIVATE_MCPS
            ):
                continue

            score = score_item(
                item,
                tt,
                task,
                idf,
                task_stacks,
            )

            if score >= MIN_SCORE:
                rows.append(
                    (
                        score,
                        item,
                    )
                )

        rows.sort(
            key=lambda z: (
                -z[0],
                z[1][
                    "name"
                ].lower(),
            )
        )

        # Keep only clear matches: weak tails are usually noise.
        if rows:
            rows = [r for r in rows if r[0] >= 0.5 * rows[0][0]]

        return [
            {
                "name":
                    item["name"],

                "kind":
                    item["kind"],

                "description":
                    item.get(
                        "description",
                        "",
                    ),

                "available_on":
                    item.get(
                        "available_on",
                        [],
                    ),

                "score":
                    round(
                        score,
                        2,
                    ),
            }

            for (
                score,
                item,
            ) in rows[:limit]
        ]

    result = {
        "mode":
            mode,

        "domain":
            domain,

        "complexity":
            complexity,

        "strategy": {
            "load_only_relevant_capabilities":
                True,

            "prefer_minimum_sufficient_set":
                True,

            "reuse_cached_results":
                True,

            "avoid_duplicate_tool_calls":
                True,

            "external_tools_only_when_materially_useful":
                True,

            "codex_workers_only_for_substantial_engineering":
                True,
        },

        "recommended_skills":
            ranked(
                data["skills"],
                skill_limit,
            ),

        "recommended_plugins":
            ranked(
                data["plugins"],
                plugin_limit,
            ),

        "recommended_mcps":
            ranked(
                data["mcps"],
                mcp_limit,
            ),
    }

    print(
        json.dumps(
            result,
            indent=2,
            ensure_ascii=False,
        )
    )


def cap_audit():
    data = (
        jload(
            INDEX,
            None,
        )
        or cap_refresh(True)
    )

    issues = []

    for skill in data[
        "skills"
    ]:
        desc = (
            skill.get(
                "description",
                "",
            )
            .strip()
        )

        if not desc:
            issues.append(
                "NO_DESCRIPTION "
                + skill["name"]
            )

        elif len(desc) < 30:
            issues.append(
                "WEAK_DESCRIPTION "
                + skill["name"]
                + ": "
                + desc
            )

    if issues:
        print(
            "\n".join(
                issues
            )
        )

    else:
        print(
            "✅ Skill metadata parser "
            "+ descriptions look healthy."
        )


def cap_record(
    caps,
    outcome,
    seconds,
):
    ensure_dirs()

    stats = jload(
        STATS,
        {},
    )

    field = (
        "success"
        if outcome.lower()
        in {
            "success",
            "ok",
            "pass",
            "passed",
        }
        else "failure"
    )

    for cap in [
        x.strip()
        for x in caps.split(",")
        if x.strip()
    ]:
        key = cap.lower()

        if ":" not in key:
            key = (
                "skill:"
                + key
            )

        row = stats.setdefault(
            key,
            {
                "success":
                    0,

                "failure":
                    0,

                "seconds":
                    0.0,

                "last_used":
                    None,
            },
        )

        row[field] = (
            int(
                row.get(
                    field,
                    0,
                )
            )
            + 1
        )

        row["seconds"] = (
            float(
                row.get(
                    "seconds",
                    0,
                )
            )
            + float(
                seconds
                or 0
            )
        )

        row["last_used"] = (
            now()
        )

    jsave(
        STATS,
        stats,
    )

    print(
        "✅ Capability outcome recorded."
    )


def cap_summary():
    data = (
        jload(
            INDEX,
            None,
        )
        or cap_refresh(True)
    )

    for account in (
        ALL_ACCOUNTS
    ):
        skills = sum(
            account
            in x.get(
                "available_on",
                [],
            )

            for x
            in data["skills"]
        )

        plugins = sum(
            account
            in x.get(
                "available_on",
                [],
            )

            for x
            in data["plugins"]
        )

        mcps = sum(
            account
            in x.get(
                "available_on",
                [],
            )

            for x
            in data["mcps"]
        )

        print(
            f"{account:8} "
            f"skills={skills:<4} "
            f"plugins={plugins:<4} "
            f"mcps={mcps:<3}"
        )


def git_root():
    rc, out = run(
        [
            "git",
            "rev-parse",
            "--show-toplevel",
        ]
    )

    if (
        rc == 0
        and out.strip()
    ):
        return Path(
            out.strip()
        ).resolve()

    return (
        Path.cwd()
        .resolve()
    )


def project_id(root):
    rc, out = run(
        [
            "git",
            "rev-parse",
            "--git-common-dir",
        ],
        cwd=str(root),
    )

    base = (
        out.strip()
        if (
            rc == 0
            and out.strip()
        )
        else str(root)
    )

    return hashlib.sha256(
        base.encode()
    ).hexdigest()[:16]


def file_digest(path):
    h = hashlib.sha256()

    try:
        with open(
            path,
            "rb",
        ) as f:

            while True:
                chunk = f.read(
                    1024 * 1024
                )

                if not chunk:
                    break

                h.update(chunk)

    except Exception:
        pass

    return h.hexdigest()


def project_fingerprint(root):
    rows = []

    for name in MANIFESTS:
        p = (
            root
            / name
        )

        if p.exists():
            rows.append(
                (
                    name,
                    file_digest(p),
                )
            )

    for p in sorted(
        root.glob(
            "*.xcodeproj/project.pbxproj"
        )
    ):
        rows.append(
            (
                str(
                    p.relative_to(
                        root
                    )
                ),
                file_digest(p),
            )
        )

    for p in sorted(
        root.glob(
            "*.xcworkspace/contents.xcworkspacedata"
        )
    ):
        rows.append(
            (
                str(
                    p.relative_to(
                        root
                    )
                ),
                file_digest(p),
            )
        )

    fp = hashlib.sha256(
        json.dumps(
            rows,
            sort_keys=True,
        ).encode()
    ).hexdigest()

    return (
        fp,
        rows,
    )


def detect_stack(root):
    stack = []
    checks = []
    tools = []

    def add(
        item,
        target,
    ):
        if item not in target:
            target.append(
                item
            )

    if (
        root
        / "pubspec.yaml"
    ).exists():

        add(
            "Flutter/Dart",
            stack,
        )

        add(
            "flutter",
            tools,
        )

        checks += [
            "flutter analyze",
            "flutter test",
        ]

    if (
        root
        / "Package.swift"
    ).exists():

        add(
            "Swift Package",
            stack,
        )

        add(
            "swift",
            tools,
        )

        checks += [
            "swift test",
        ]

    if (
        list(
            root.glob(
                "*.xcodeproj"
            )
        )
        or list(
            root.glob(
                "*.xcworkspace"
            )
        )
    ):
        add(
            "Xcode",
            stack,
        )

        add(
            "xcodebuild",
            tools,
        )

        add(
            "swift",
            tools,
        )

    if (
        root
        / "package.json"
    ).exists():

        add(
            "Node.js",
            stack,
        )

        add(
            "node",
            tools,
        )

        if (
            root
            / "pnpm-lock.yaml"
        ).exists():
            pm = "pnpm"

        elif (
            root
            / "yarn.lock"
        ).exists():
            pm = "yarn"

        elif (
            root
            / "bun.lockb"
        ).exists() or (
            root
            / "bun.lock"
        ).exists():
            pm = "bun"

        else:
            pm = "npm"

        add(
            pm,
            tools,
        )

        package = jload(
            root
            / "package.json",
            {},
        )

        scripts = (
            package.get(
                "scripts",
                {},
            )
            if isinstance(
                package,
                dict,
            )
            else {}
        )

        for script in [
            "lint",
            "typecheck",
            "test",
            "build",
        ]:
            if (
                script
                in scripts
            ):
                checks.append(
                    (
                        f"npm run {script}"
                        if pm == "npm"
                        else f"{pm} {script}"
                    )
                )

    if (
        root
        / "pyproject.toml"
    ).exists() or (
        root
        / "requirements.txt"
    ).exists():

        add(
            "Python",
            stack,
        )

        add(
            "python3",
            tools,
        )

        if (
            root
            / "tests"
        ).exists():
            checks.append(
                "python -m pytest -q"
            )

    if (
        root
        / "Cargo.toml"
    ).exists():

        add(
            "Rust",
            stack,
        )

        add(
            "cargo",
            tools,
        )

        checks.append(
            "cargo test"
        )

    if (
        root
        / "go.mod"
    ).exists():

        add(
            "Go",
            stack,
        )

        add(
            "go",
            tools,
        )

        checks.append(
            "go test ./..."
        )

    if (
        root
        / "build.gradle"
    ).exists() or (
        root
        / "build.gradle.kts"
    ).exists():

        add(
            "Gradle/JVM",
            stack,
        )

        add(
            "java",
            tools,
        )

    return (
        stack,
        checks,
        tools,
    )


def toolchain_info(
    root=None,
):
    root = (
        root
        or git_root()
    )

    (
        stack,
        checks,
        needed,
    ) = detect_stack(root)

    found = {
        x:
            shutil.which(x)

        for x in needed
    }

    return {
        "root":
            str(root),

        "stack":
            stack,

        "checks":
            checks,

        "required_tools":
            needed,

        "found":
            found,

        "missing": [
            x
            for x, value
            in found.items()
            if not value
        ],

        "codex_universal_fallback":
            "ghcr.io/openai/codex-universal:latest",

        "auto_install":
            False,
    }


def project_bootstrap(
    force=False,
):
    ensure_dirs()

    root = git_root()
    pid = project_id(root)

    directory = (
        PROJ_DIR
        / pid
    )

    directory.mkdir(
        parents=True,
        exist_ok=True,
    )

    (
        fingerprint,
        manifests,
    ) = project_fingerprint(
        root
    )

    path = (
        directory
        / "profile.json"
    )

    old = jload(
        path,
        {},
    )

    if (
        not force
        and old.get(
            "fingerprint"
        )
        == fingerprint
    ):
        print(path)
        return

    (
        stack,
        checks,
        needed,
    ) = detect_stack(
        root
    )

    generic = (
        "Develop, review, test, "
        "and maintain this "
        + (
            ", ".join(stack)
            if stack
            else "software"
        )
        + " project"
    )

    data = {
        "version":
            2,

        "generated_at":
            now(),

        "root":
            str(root),

        "id":
            pid,

        "fingerprint":
            fingerprint,

        "manifests":
            manifests,

        "stack":
            stack,

        "checks":
            checks,

        "required_tools":
            needed,

        "toolchain":
            toolchain_info(
                root
            ),

        "capability_hint_request":
            generic,

        "cache_valid_until_manifest_change":
            True,
    }

    jsave(
        path,
        data,
    )

    print(path)


def project_show():
    root = git_root()

    path = (
        PROJ_DIR
        / project_id(root)
        / "profile.json"
    )

    if not path.exists():
        project_bootstrap()

    print(
        path.read_text()
    )


def review_route(task):
    root = git_root()

    rc, diff = run(
        [
            "git",
            "diff",
            "--no-ext-diff",
            "HEAD",
        ],
        cwd=str(root),
        timeout=20,
    )

    sample = (
        task
        + "\n"
        + diff[:200000]
    ).lower()

    files = []

    rc, out = run(
        [
            "git",
            "diff",
            "--name-only",
            "HEAD",
        ],
        cwd=str(root),
    )

    if rc == 0:
        files = [
            x
            for x
            in out.splitlines()
            if x.strip()
        ]

    reviewers = []

    def add(
        name,
        reason,
        model="inherit",
    ):
        if not any(
            x["name"]
            == name
            for x in reviewers
        ):
            reviewers.append(
                {
                    "name":
                        name,

                    "reason":
                        reason,

                    "model":
                        model,
                }
            )

    risk = [
        "auth",
        "authorization",
        "permission",
        "security",
        "secret",
        "payment",
        "billing",
        "subscription",
        "database",
        "schema",
        "migration",
        "privacy",
        "encryption",
        "oauth",
        "token",
        "production",
        "deploy",
        "صلاحيات",
        "أمان",
        "دفع",
        "اشتراك",
        "قاعدة البيانات",
        "خصوصية",
    ]

    if any(
        x in sample
        for x in risk
    ):
        add(
            "agent-risk-reviewer",
            "high-risk change",
            "opus",
        )

    if any(
        x in sample
        for x in [
            "catch",
            "except",
            "fallback",
            "recover",
            "error handling",
        ]
    ):
        add(
            "silent-failure-hunter",
            "error/fallback paths changed",
        )

    if any(
        x in sample
        for x in [
            "type ",
            "interface ",
            "struct ",
            "enum ",
            "schema",
            "model",
        ]
    ) or any(
        re.search(
            r"(types?|models?|schema)",
            f,
            re.I,
        )
        for f in files
    ):
        add(
            "type-design-analyzer",
            "type/schema design changed",
        )

    if (
        files
        or any(
            x in sample
            for x in [
                "test",
                "spec",
            ]
        )
    ):
        add(
            "pr-test-analyzer",
            "verify behavioral coverage",
        )

    if any(
        x in sample
        for x in [
            "refactor",
            "simplif",
            "cleanup",
            "complex",
        ]
    ):
        add(
            "code-simplifier",
            "complexity/refactor work",
        )

    if any(
        f.lower().endswith(
            (
                ".md",
                ".mdx",
            )
        )
        for f in files
    ):
        add(
            "comment-analyzer",
            "documentation/comments changed",
        )

    if files:
        add(
            "code-reviewer",
            "general final review",
            (
                "opus"
                if len(files) > 20
                else "inherit"
            ),
        )

    print(
        json.dumps(
            {
                "files":
                    files,

                "reviewers":
                    reviewers,
            },
            indent=2,
            ensure_ascii=False,
        )
    )


def proof_capture(
    task,
    run_checks=False,
):
    ensure_dirs()

    root = git_root()
    pid = project_id(root)

    directory = (
        PROOF_DIR
        / pid
    )

    directory.mkdir(
        parents=True,
        exist_ok=True,
    )

    profile = jload(
        PROJ_DIR
        / pid
        / "profile.json",
        {},
    )

    if not profile:
        project_bootstrap()

        profile = jload(
            PROJ_DIR
            / pid
            / "profile.json",
            {},
        )

    def gout(args):
        return run(
            [
                "git",
                *args,
            ],
            cwd=str(root),
            timeout=20,
        )[1].strip()

    checks = []

    if run_checks:
        for command in (
            profile.get(
                "checks",
                [],
            )[:8]
        ):
            start = time.time()

            rc, out = run(
                command,
                cwd=str(root),
                timeout=900,
                shell=True,
            )

            checks.append(
                {
                    "command":
                        command,

                    "exit_code":
                        rc,

                    "seconds":
                        round(
                            time.time()
                            - start,
                            2,
                        ),

                    "output_tail":
                        out[-5000:],
                }
            )

    status = gout(
        [
            "status",
            "--short",
        ]
    )

    data = {
        "generated_at":
            now(),

        "task":
            task,

        "root":
            str(root),

        "branch":
            gout(
                [
                    "branch",
                    "--show-current",
                ]
            ),

        "head":
            gout(
                [
                    "rev-parse",
                    "HEAD",
                ]
            ),

        "status":
            status,

        "diffstat":
            gout(
                [
                    "diff",
                    "--stat",
                    "HEAD",
                ]
            ),

        "checks":
            checks,

        "check_pass":
            (
                all(
                    x["exit_code"]
                    == 0
                    for x in checks
                )
                if checks
                else None
            ),

        "worktree_clean":
            not bool(status),

        "proof_contract": {
            "commit_or_diff":
                "captured",

            "tests_build_lint":
                "captured when --checks",

            "review":
                "required when risk warrants",

            "performance":
                "before/after evidence required for performance claims",

            "visual":
                "visual evidence required for visual claims",

            "remaining_risks":
                "lead must explicitly list remaining risks",
        },
    }

    path = (
        directory
        / (
            datetime.now()
            .strftime(
                "%Y%m%d-%H%M%S"
            )
            + ".json"
        )
    )

    jsave(
        path,
        data,
    )

    print(path)


def promote_skill(src):
    ensure_dirs()

    src = (
        Path(src)
        .expanduser()
        .resolve()
    )

    skill = (
        src
        / "SKILL.md"
    )

    if not skill.exists():
        print(
            "REFUSED: SKILL.md missing",
            file=sys.stderr,
        )

        return 2

    fm, body = (
        parse_frontmatter(
            skill
        )
    )

    name = (
        fm.get("name")
        or src.name
    ).strip()

    desc = (
        fm.get(
            "description"
        )
        or ""
    ).strip()

    if len(desc) < 30:
        print(
            "REFUSED: description "
            "is missing/too weak",
            file=sys.stderr,
        )

        return 3

    text = (
        skill.read_text(
            errors="ignore"
        )
    )

    dependency_markers = [
        "CLAUDE_PLUGIN_ROOT",
        "CODEX_PLUGIN_ROOT",
        ".codex-plugin",
        ".claude-plugin",
    ]

    if any(
        marker in text
        for marker
        in dependency_markers
    ):
        print(
            "REFUSED: plugin-bound skill; "
            "keep it native instead of "
            "promoting standalone.",
            file=sys.stderr,
        )

        return 4

    report_dir = (
        BASE
        / "promotion-reports"
    )

    report_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    plugin_eval = (
        shutil.which(
            "plugin-eval"
        )
    )

    if plugin_eval:
        rc, out = run(
            [
                plugin_eval,
                "analyze",
                str(src),
                "--format",
                "markdown",
            ],
            timeout=120,
        )

        (
            report_dir
            / (
                name
                + "-"
                + str(
                    int(
                        time.time()
                    )
                )
                + ".md"
            )
        ).write_text(out)

        if rc != 0:
            print(
                "REFUSED: plugin-eval "
                "static analysis failed",
                file=sys.stderr,
            )

            return 5

    dst = (
        HOME
        / ".agents"
        / "skills"
        / name
    )

    dst.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    if dst.exists():
        backup = (
            BASE
            / "backups"
            / (
                "skill-"
                + name
                + "-"
                + datetime.now()
                .strftime(
                    "%Y%m%d-%H%M%S"
                )
            )
        )

        backup.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        shutil.copytree(
            dst,
            backup,
            dirs_exist_ok=True,
        )

        shutil.rmtree(
            dst
        )

    shutil.copytree(
        src,
        dst,
        symlinks=True,
    )

    cap_refresh(True)

    print(
        "✅ Promoted portable skill:",
        name,
        "->",
        dst,
    )

    return 0


def upstream_refresh():
    ensure_dirs()

    old = jload(
        UPSTREAM_STATE,
        {},
    )

    current = {}
    changed = []

    for (
        name,
        url,
    ) in UPSTREAMS.items():

        rc, out = run(
            [
                "git",
                "ls-remote",
                url,
                "HEAD",
            ],
            timeout=20,
        )

        sha = (
            out.split()[0]
            if (
                rc == 0
                and out.split()
            )
            else None
        )

        current[name] = {
            "url":
                url,

            "head":
                sha,

            "checked_at":
                now(),
        }

        previous = (
            old.get(
                name,
                {},
            )
            .get(
                "head"
            )
        )

        if (
            sha
            and previous
            and previous != sha
        ):
            changed.append(
                name
            )

    jsave(
        UPSTREAM_STATE,
        current,
    )

    vendor = (
        VENDOR_DIR
        / "openai-plugins"
    )

    if (
        vendor.exists()
        and (
            vendor
            / ".git"
        ).exists()
    ):
        run(
            [
                "git",
                "pull",
                "--ff-only",
            ],
            cwd=str(vendor),
            timeout=120,
        )

    if (
        "openai/plugins"
        in changed
        or not old
    ):
        for account in [
            "codex1",
            "codex2",
        ]:
            env = (
                os.environ.copy()
            )

            env[
                "CODEX_HOME"
            ] = str(
                ACCOUNTS[
                    account
                ]["home"]
            )

            run(
                [
                    "codex",
                    "plugin",
                    "marketplace",
                    "upgrade",
                    "openai-curated",
                ],
                env=env,
                timeout=120,
            )

            for plugin in (
                CODEX_PLUGINS
            ):
                run(
                    [
                        "codex",
                        "plugin",
                        "add",
                        plugin
                        + "@openai-curated",
                        "--json",
                    ],
                    env=env,
                    timeout=120,
                )

    model_tool = (
        HOME
        / "bin"
        / "agent-models"
    )

    if model_tool.exists():
        run(
            [
                str(model_tool),
                "refresh",
                "--if-stale",
                "1",
                "--quiet",
            ],
            timeout=120,
        )

    plugin_sync = (
        HOME
        / "bin"
        / "agent-plugins-sync"
    )

    if plugin_sync.exists():
        run(
            [
                str(plugin_sync),
                "--quiet",
            ],
            timeout=120,
        )

    cap_refresh(True)

    print(
        json.dumps(
            {
                "changed":
                    changed,

                "checked":
                    len(current),

                "state":
                    str(
                        UPSTREAM_STATE
                    ),
            },
            indent=2,
        )
    )


def upstream_status():
    print(
        json.dumps(
            jload(
                UPSTREAM_STATE,
                {},
            ),
            indent=2,
            ensure_ascii=False,
        )
    )


# ---------------------------------------------------------------- upstream skill revision audit
#
# `agent-upstream skills [--write]`: for every git-backed source in
# ~/.agents/skill-sources.json, clone upstream (bare, shallow, blobless) into a
# fresh temp dir, compare each installed skill folder with upstream HEAD and the
# last N first-parent commits, and report current / behind / locally-modified /
# unknown. Upstream content is untrusted: only git plumbing reads it (no
# checkout, no hooks, no submodules, nothing executed or imported from it).

SKILL_SOURCES = HOME / ".agents" / "skill-sources.json"
SKILL_LOCK = HOME / ".agents" / ".skill-lock.json"
SHARED_SKILLS = HOME / ".agents" / "skills"
AUDIT_IGNORE = {".DS_Store", ".git", "__pycache__", "node_modules"}
AUDIT_MAX_BLOB_READS = 40
AUDIT_GIT_SAFE = [
    "-c", "core.hooksPath=/dev/null",
    "-c", "core.fsmonitor=false",
    "-c", "protocol.allow=never",
    "-c", "protocol.https.allow=always",
    "-c", "credential.helper=",
    "-c", "submodule.recurse=false",
    "-c", "fetch.recurseSubmodules=false",
    "-c", "transfer.fsckObjects=false",
]


def _audit_env():
    env = os.environ.copy()
    env.update({
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_ASKPASS": "/usr/bin/false",
        "SSH_ASKPASS": "/usr/bin/false",
        "GCM_INTERACTIVE": "never",
        "GIT_LFS_SKIP_SMUDGE": "1",
    })
    return env


class _Repo:
    """A bare, shallow, blobless clone used read-only through git plumbing."""

    def __init__(self, url, workdir, window):
        self.url = url
        self.workdir = workdir
        self.window = window
        self.gitdir = None
        self.error = None
        self.commits = []      # first-parent window, newest first
        self.index = {}
        self.head = None
        self.extra = {}        # pinned commits fetched outside the window
        self.blob_reads = 0
        self._tree_cache = {}
        self._blob_cache = {}
        self._head_tree = None

    def git(self, args, timeout=180):
        cmd = ["git"] + AUDIT_GIT_SAFE
        if self.gitdir:
            cmd += ["--git-dir", str(self.gitdir)]
        try:
            p = subprocess.run(cmd + args, cwd=str(self.workdir), env=_audit_env(),
                               capture_output=True, timeout=timeout)
            return p.returncode, p.stdout, p.stderr.decode("utf-8", "replace")
        except subprocess.TimeoutExpired:
            return 124, b"", "timeout"
        except Exception as e:
            return 1, b"", "%s: %s" % (type(e).__name__, e)

    def clone(self):
        name = re.sub(r"[^A-Za-z0-9._-]", "_", self.url.split("github.com/")[-1])
        target = Path(self.workdir) / (name + ".git")
        rc, _, err = self.git(["clone", "--quiet", "--bare", "--depth", str(self.window),
                               "--filter=blob:none", "--single-branch", "--no-tags",
                               self.url, str(target)], timeout=600)
        if rc != 0:
            self.error = "clone failed: " + err.strip()[-300:]
            return False
        self.gitdir = target
        rc, out, err = self.git(["rev-list", "--first-parent", "-n", str(self.window), "HEAD"])
        if rc != 0:
            self.error = "rev-list failed: " + err.strip()[-200:]
            return False
        self.commits = out.decode().split()
        self.index = {c: i for i, c in enumerate(self.commits)}
        self.head = self.commits[0] if self.commits else None
        return bool(self.head)

    def fetch_commit(self, sha):
        """Fetch one pinned commit (trees only) that lies outside the window."""
        if sha in self.index or sha in self.extra:
            return sha in self.index or self.extra.get(sha, False)
        rc, _, _ = self.git(["fetch", "--quiet", "--depth", "1", "--filter=blob:none",
                             "--no-tags", "origin", sha], timeout=300)
        ok = rc == 0 and self.git(["cat-file", "-e", sha + "^{commit}"])[0] == 0
        self.extra[sha] = ok
        return ok

    def head_paths(self):
        if self._head_tree is None:
            rc, out, _ = self.git(["ls-tree", "-r", "-z", "--name-only", "--full-tree", "HEAD"])
            self._head_tree = [p for p in out.decode("utf-8", "replace").split("\0") if p] if rc == 0 else []
        return self._head_tree

    def tree_map(self, commit, folder):
        key = (commit, folder)
        if key in self._tree_cache:
            return self._tree_cache[key]
        args = ["ls-tree", "-r", "-z", "--full-tree", commit]
        if folder:
            args += ["--", folder + "/"]
        rc, out, _ = self.git(args)
        result = {}
        if rc == 0:
            for entry in out.decode("utf-8", "replace").split("\0"):
                if not entry or "\t" not in entry:
                    continue
                meta, path = entry.split("\t", 1)
                parts = meta.split()
                if len(parts) != 3 or parts[1] != "blob":
                    continue
                rel = path[len(folder) + 1:] if folder else path
                # Symlinks are tagged: installers usually dereference them.
                result[rel] = ("L:" + parts[2]) if parts[0] == "120000" else parts[2]
        self._tree_cache[key] = result
        return result

    def tree_id(self, commit, folder):
        rc, out, _ = self.git(["rev-parse", "--verify", "--quiet", "%s:%s" % (commit, folder)])
        return out.decode().strip() if rc == 0 else None

    def touching(self, folder):
        args = ["log", "--first-parent", "--format=%H", "-n", str(self.window), "HEAD"]
        if folder:
            args += ["--", folder]
        rc, out, _ = self.git(args)
        if rc != 0:
            return []
        return [c for c in out.decode().split() if c in self.index]

    def blob(self, sha):
        if sha in self._blob_cache:
            return self._blob_cache[sha]
        if self.blob_reads >= AUDIT_MAX_BLOB_READS * 4:
            return None
        self.blob_reads += 1
        rc, out, _ = self.git(["cat-file", "blob", sha], timeout=120)
        self._blob_cache[sha] = out if rc == 0 else None
        return self._blob_cache[sha]


def _audit_blob_sha1(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def _audit_local_map(skill_dir):
    root = Path(os.path.realpath(skill_dir))
    out = {}
    for dirpath, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in AUDIT_IGNORE]
        # os.walk lists symlinks to directories under dirs; git stores them as blobs.
        links = [d for d in dirs if os.path.islink(os.path.join(dirpath, d))]
        for f in files + links:
            if f in AUDIT_IGNORE or ".bak-" in f:
                continue
            p = Path(dirpath) / f
            try:
                data = os.readlink(p).encode() if p.is_symlink() else p.read_bytes()
            except OSError:
                continue
            out[p.relative_to(root).as_posix()] = _audit_blob_sha1(data)
    return out


def _audit_version(text):
    if not text:
        return None
    if isinstance(text, bytes):
        text = text.decode("utf-8", "replace")
    m = re.match(r"^---\s*\n(.*?)\n---", text, re.S)
    if not m:
        return None
    v = re.search(r"^\s*version:\s*[\"']?([^\"'\n#]+)", m.group(1), re.M)
    return v.group(1).strip() if v else None


def _audit_repo_spec(url):
    m = re.match(r"^https://github\.com/([^/\s]+)/([^/#?\s]+?)(?:\.git)?(?:/tree/([^/]+)(?:/(.*))?)?/?$", url or "")
    if not m:
        return None
    return {"url": "https://github.com/%s/%s.git" % (m.group(1), m.group(2)),
            "subdir": (m.group(4) or "").strip("/")}


def _audit_clean_path(path):
    path = (path or "").split(" (")[0].strip()
    if not path or path.startswith(("~", "/", "Local ")) or not path.endswith("SKILL.md"):
        return None
    return path


def _audit_locate(repo, skill, hint_paths, local):
    """Return (folder, note). folder '' means the repository root."""
    for hint in hint_paths:
        if hint:
            folder = hint.rsplit("/", 1)[0] if "/" in hint else ""
            if hint in repo.head_paths():
                return folder, None
    found = [p for p in repo.head_paths() if p == skill + "/SKILL.md" or p.endswith("/" + skill + "/SKILL.md")]
    if not found and "SKILL.md" in repo.head_paths() and len(hint_paths) == 0:
        found = ["SKILL.md"]
    if not found:
        for hint in hint_paths:
            if hint:
                return (hint.rsplit("/", 1)[0] if "/" in hint else ""), "recorded path not present at HEAD"
        alt = [p for p in repo.head_paths() if re.search(r"(^|/)%s/skill\.md$" % re.escape(skill), p, re.I)]
        return None, "no %s/SKILL.md at upstream HEAD%s" % (
            skill, (" (found %s; likely installed by a package installer)" % alt[0]) if alt else "")
    if len(found) > 1:
        want = local.get("SKILL.md")
        exact = [p for p in found if repo.tree_map("HEAD", p.rsplit("/", 1)[0] if "/" in p else "").get("SKILL.md") == want]
        pick = (exact or sorted(found, key=len))[0]
        return (pick.rsplit("/", 1)[0] if "/" in pick else ""), "ambiguous path; picked %s of %d" % (pick, len(found))
    p = found[0]
    return (p.rsplit("/", 1)[0] if "/" in p else ""), None


def _audit_compare(upstream, local):
    """strict: every upstream file installed and identical; loose: SKILL.md and every
    file present on both sides identical."""
    if not upstream or "SKILL.md" not in upstream or upstream.get("SKILL.md") != local.get("SKILL.md"):
        return None
    common, missing = [], 0
    for k, v in upstream.items():
        if v.startswith("L:"):
            if local.get(k) == v[2:] or any(x.startswith(k + "/") for x in local):
                continue        # symlink kept, or dereferenced into a directory
            missing += 1
        elif k in local:
            common.append(k)
        else:
            missing += 1
    if any(upstream[k] != local[k] for k in common):
        return None
    return ("strict" if missing == 0 else "loose"), missing


def _audit_skill(repo, source, skill, review, lock_entry, window):
    res = {"skill": skill, "source": source.get("id"), "status": "unknown", "upstream_path": None,
           "matched_commit": None, "match": None, "skill_commits_behind": None,
           "repo_commits_behind": None, "behind_lower_bound": False, "upstream_head": repo.head,
           "installed_version": None, "upstream_version": None, "note": None,
           "_range": None}
    skill_dir = SHARED_SKILLS / skill
    if not (skill_dir / "SKILL.md").is_file():
        res["note"] = "not installed in ~/.agents/skills"
        return res
    local = _audit_local_map(skill_dir)
    try:
        local_text = (skill_dir / "SKILL.md").read_bytes()
    except OSError:
        local_text = b""
    res["installed_version"] = _audit_version(local_text)
    spec = _audit_repo_spec(source.get("repository"))
    hints = []
    if review:
        hints.append(_audit_clean_path(review.get("source_path")))
    if lock_entry:
        hints.append(_audit_clean_path(lock_entry.get("skillPath")))
    hints = [h for h in hints if h]
    if spec and spec["subdir"]:
        hints = [h if h.startswith(spec["subdir"] + "/") else spec["subdir"] + "/" + h for h in hints] + hints
    folder, note = _audit_locate(repo, skill, hints, local)
    if folder is None:
        res["note"] = note
        return res
    res["upstream_path"] = (folder + "/SKILL.md") if folder else "SKILL.md"
    res["note"] = note
    touching = repo.touching(folder)
    # Content at a touching commit stays valid until the next newer touching commit.
    candidates = []
    newer_idx = -1
    for n, c in enumerate(touching):
        candidates.append((c, newer_idx + 1, repo.index[c], n))
        newer_idx = repo.index[c]
    if not touching:
        candidates.append((repo.head, 0, len(repo.commits) - 1, 0))
    elif touching[-1] != repo.commits[-1]:
        # Content older than the oldest touching commit inside the window.
        oldest = repo.commits[-1]
        candidates.append((oldest, repo.index[touching[-1]] + 1, len(repo.commits) - 1, len(touching)))
    pinned = source.get("source_revision")
    if isinstance(pinned, str) and re.fullmatch(r"[0-9a-f]{40}", pinned) and pinned not in repo.index:
        if repo.fetch_commit(pinned):
            candidates.append((pinned, len(repo.commits), len(repo.commits), len(touching)))

    def finish(status, cand, how, lower=False):
        commit, newest, oldest, skill_behind = cand
        res["status"] = status
        res["match"] = how
        if newest < len(repo.commits):
            res["matched_commit"] = repo.commits[newest]
        else:
            res["matched_commit"] = commit
            lower = True
        res["skill_commits_behind"] = skill_behind
        res["repo_commits_behind"] = min(newest, len(repo.commits))
        res["behind_lower_bound"] = lower
        res["_range"] = (newest, oldest)
        if status != "current":
            head_map = repo.tree_map("HEAD", folder)
            if head_map.get("SKILL.md"):
                res["upstream_version"] = _audit_version(repo.blob(head_map["SKILL.md"]))
        return res

    loose = None
    for cand in candidates:
        cmp = _audit_compare(repo.tree_map(cand[0], folder), local)
        if cmp and cmp[0] == "strict":
            return finish("current" if cand[1] == 0 else "behind", cand, "exact")
        if cmp and loose is None:
            loose = (cand, cmp[1])
    if loose:
        cand, missing = loose
        res["note"] = "; ".join(x for x in [res["note"], "%d upstream file(s) not installed" % missing] if x)
        return finish("current" if cand[1] == 0 else "behind", cand, "installed-files")

    # No content match: find the upstream base the local copy was taken from.
    want_sha256 = review.get("source_sha256") if review else None
    lock_tree = lock_entry.get("skillFolderHash") if lock_entry else None
    reads = 0
    for cand in candidates:
        umap = repo.tree_map(cand[0], folder)
        if not umap:
            continue
        if lock_tree and repo.tree_id(cand[0], folder) == lock_tree:
            return finish("locally-modified", cand, "base:skill-lock-tree")
        if want_sha256 and umap.get("SKILL.md") and reads < AUDIT_MAX_BLOB_READS:
            reads += 1
            data = repo.blob(umap["SKILL.md"])
            if data is not None and hashlib.sha256(data).hexdigest() == want_sha256:
                return finish("locally-modified", cand, "base:source_sha256")
    for cand in candidates:
        umap = repo.tree_map(cand[0], folder)
        files = [k for k in umap if k != "SKILL.md" and not umap[k].startswith("L:")]
        others = [k for k in files if k in local]
        if others and len(others) == len(files) and all(umap[k] == local[k] for k in others):
            return finish("locally-modified", cand, "base:non-SKILL.md-files")
    comparison = (review or {}).get("comparison", "")
    if comparison and comparison != "exact":
        res["status"] = "locally-modified"
        res["match"] = "registry:" + comparison
        res["note"] = "; ".join(x for x in [res["note"], "no upstream base found in last %d commits" % window] if x)
        head_map = repo.tree_map("HEAD", folder)
        if head_map.get("SKILL.md"):
            res["upstream_version"] = _audit_version(repo.blob(head_map["SKILL.md"]))
        return res
    res["note"] = "; ".join(x for x in [res["note"], "no matching upstream content in last %d commits" % window] if x)
    return res


def _audit_source_revision(repo, results):
    ranges = [r["_range"] for r in results if r.get("_range")]
    if not ranges or not repo.commits:
        return None, None
    newest = max(a for a, _ in ranges)
    oldest = min(b for _, b in ranges)
    if newest > oldest:
        return None, "mixed"
    if newest >= len(repo.commits):
        commits = set(r["matched_commit"] for r in results if r.get("_range"))
        return (commits.pop() if len(commits) == 1 else None), "outside-window"
    basis = "exact" if all(r["match"] in ("exact", "installed-files") for r in results if r.get("_range")) else "base"
    return repo.commits[newest], basis


def upstream_skills(write=False, only=None, exclude=None, window=200, as_json=False, jobs=4):
    import tempfile
    from concurrent.futures import ThreadPoolExecutor

    only = set(only or [])
    exclude = set(exclude or [])
    data = jload(SKILL_SOURCES, None)
    if not isinstance(data, dict):
        raise SystemExit("cannot read %s" % SKILL_SOURCES)
    lock = (jload(SKILL_LOCK, {}) or {}).get("skills", {})

    plan = {}          # repo url -> [(source, [skills])]
    skipped = []
    for src in data.get("sources", []):
        sid = src.get("id")
        if only and sid not in only:
            continue
        if sid in exclude:
            continue
        skills = [s for s in src.get("skills", []) if s not in exclude]
        spec = _audit_repo_spec(src.get("repository"))
        if not skills:
            continue
        if not spec:
            skipped.append((sid, src.get("repository") or "device-local (no upstream)", skills))
            continue
        plan.setdefault(spec["url"], []).append((src, skills))

    workdir = Path(tempfile.mkdtemp(prefix="agent-upstream-skills-"))
    started = now()

    def audit_repo(url):
        repo = _Repo(url, workdir, window)
        out = []
        if not repo.clone():
            for src, skills in plan[url]:
                for s in skills:
                    out.append((src, {"skill": s, "source": src.get("id"), "status": "unknown",
                                      "note": repo.error, "upstream_head": None}))
            return repo, out
        for src, skills in plan[url]:
            reviews = src.get("skill_reviews") or {}
            for s in skills:
                try:
                    r = _audit_skill(repo, src, s, reviews.get(s), lock.get(s), window)
                except Exception as e:
                    r = {"skill": s, "source": src.get("id"), "status": "unknown",
                         "note": "audit error: %s: %s" % (type(e).__name__, e), "upstream_head": repo.head}
                out.append((src, r))
        return repo, out

    try:
        with ThreadPoolExecutor(max_workers=max(1, jobs)) as pool:
            done = list(pool.map(audit_repo, sorted(plan)))
    finally:
        shutil.rmtree(workdir, ignore_errors=True)

    rows = []
    per_source = {}
    for repo, out in done:
        for src, r in out:
            rows.append(r)
            per_source.setdefault(src.get("id"), (repo, []))[1].append(r)
    order = {s.get("id"): i for i, s in enumerate(data.get("sources", []))}
    rows.sort(key=lambda r: (order.get(r["source"], 999), r["skill"]))

    source_rev = {}
    for sid, (repo, results) in per_source.items():
        rev, basis = _audit_source_revision(repo, results)
        source_rev[sid] = {"revision": rev, "basis": basis, "upstream_head": repo.head,
                           "repository_url": repo.url, "error": repo.error}

    checked_at = now()
    if write:
        _audit_write(per_source, source_rev, checked_at, window)

    public = [{k: v for k, v in r.items() if not k.startswith("_")} for r in rows]
    if as_json:
        print(json.dumps({"checked_at": checked_at, "window": window, "written": bool(write),
                          "sources": source_rev, "skills": public,
                          "not_git_backed": [{"source": a, "repository": b, "skills": c} for a, b, c in skipped]},
                         indent=2, ensure_ascii=False))
        return 0

    def behind_text(r):
        if r.get("skill_commits_behind") is None:
            return "-"
        plus = "+" if r.get("behind_lower_bound") else ""
        return "%d%s/%d%s" % (r["skill_commits_behind"], plus, r.get("repo_commits_behind") or 0, plus)

    print("Upstream skill revision audit  (window: last %d first-parent commits; started %s)" % (window, started))
    print("behind = skill-folder commits / repo commits since the newest matching upstream commit ('+' = at least)")
    print()
    w1 = max([len(r["source"]) for r in public] + [6])
    w2 = max([len(r["skill"]) for r in public] + [5])
    print("%-*s  %-*s  %-16s  %-12s  %-9s  %-15s  %s" % (w1, "source", w2, "skill", "status", "commit", "behind",
                                                        "version", "note"))
    print("-" * (w1 + w2 + 80))
    for r in public:
        ver = ""
        if r.get("installed_version") or r.get("upstream_version"):
            ver = "%s->%s" % (r.get("installed_version") or "?", r.get("upstream_version") or "?") \
                if r.get("upstream_version") and r.get("upstream_version") != r.get("installed_version") \
                else (r.get("installed_version") or "")
        note = r.get("note") or ""
        if r.get("match") and r.get("match") not in ("exact",):
            note = "; ".join(x for x in [r["match"], note] if x)
        print("%-*s  %-*s  %-16s  %-12s  %-9s  %-15s  %s" % (
            w1, r["source"], w2, r["skill"], r["status"], (r.get("matched_commit") or "-")[:12],
            behind_text(r), ver, note))
    print()
    counts = {}
    for r in public:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print("SUMMARY  " + "  ".join("%s=%d" % (k, counts[k]) for k in sorted(counts)))
    for sid in sorted(source_rev, key=lambda s: order.get(s, 999)):
        v = source_rev[sid]
        print("  %-42s revision=%s (%s) head=%s%s" % (sid, (v["revision"] or "-")[:12], v["basis"] or "-",
                                                    (v["upstream_head"] or "-")[:12],
                                                    ("  ERROR " + v["error"]) if v.get("error") else ""))
    for sid, repo_url, skills in skipped:
        print("  %-42s not git-backed (%s): %s" % (sid, repo_url, ", ".join(skills)))
    print()
    print("written to %s" % SKILL_SOURCES if write else "read-only: rerun with --write to record revisions")
    return 0


def _audit_write(per_source, source_rev, checked_at, window):
    # Re-read right before writing so concurrent edits to other entries survive;
    # only audit-owned fields are touched.
    text = SKILL_SOURCES.read_text()
    data = json.loads(text)
    for src in data.get("sources", []):
        sid = src.get("id")
        if sid not in per_source:
            continue
        repo, results = per_source[sid]
        if repo.error:
            continue
        info = source_rev[sid]
        src["revision"] = info["revision"]
        src["revision_basis"] = info["basis"]
        src["upstream_head"] = info["upstream_head"]
        src["revision_checked_at"] = checked_at
        src["revision_window"] = window
        status = src.get("skill_status") if isinstance(src.get("skill_status"), dict) else {}
        for r in results:
            status[r["skill"]] = {k: r.get(k) for k in (
                "status", "matched_commit", "match", "skill_commits_behind", "repo_commits_behind",
                "behind_lower_bound", "upstream_path", "installed_version", "upstream_version", "note")
                if r.get(k) is not None}
            status[r["skill"]]["checked_at"] = checked_at
        src["skill_status"] = status
        rt = src.get("revision_tracking") or ""
        if "upstream commit SHA is not recorded" in rt:
            src["revision_tracking"] = rt.replace(
                "upstream commit SHA is not recorded",
                "installed upstream commit is recorded in `revision` and per-skill state in `skill_status` "
                "by `agent-upstream skills --write`")
    out = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    json.loads(out)
    tmp = SKILL_SOURCES.with_name("." + SKILL_SOURCES.name + ".tmp-%d" % os.getpid())
    tmp.write_text(out)
    try:
        os.chmod(tmp, SKILL_SOURCES.stat().st_mode & 0o7777)
    except OSError:
        pass
    os.replace(tmp, SKILL_SOURCES)
    json.loads(SKILL_SOURCES.read_text())



def main():
    ensure_dirs()

    parser = argparse.ArgumentParser(
        prog="agent-intel"
    )

    groups = (
        parser.add_subparsers(
            dest="group",
            required=True,
        )
    )

    cap = groups.add_parser(
        "cap"
    )

    cap_sub = (
        cap.add_subparsers(
            dest="cmd",
            required=True,
        )
    )

    refresh = (
        cap_sub.add_parser(
            "refresh"
        )
    )

    refresh.add_argument(
        "--quiet",
        action="store_true",
    )

    recommend = (
        cap_sub.add_parser(
            "recommend"
        )
    )

    recommend.add_argument(
        "task",
        nargs=argparse.REMAINDER,
    )

    cap_sub.add_parser(
        "audit"
    )

    record = (
        cap_sub.add_parser(
            "record"
        )
    )

    record.add_argument(
        "caps"
    )

    record.add_argument(
        "outcome"
    )

    record.add_argument(
        "seconds",
        nargs="?",
        default="0",
    )

    cap_sub.add_parser(
        "summary"
    )

    project = (
        groups.add_parser(
            "project"
        )
    )

    project_sub = (
        project.add_subparsers(
            dest="cmd",
            required=True,
        )
    )

    bootstrap = (
        project_sub.add_parser(
            "bootstrap"
        )
    )

    bootstrap.add_argument(
        "--force",
        action="store_true",
    )

    project_sub.add_parser(
        "show"
    )

    toolchain = (
        groups.add_parser(
            "toolchain"
        )
    )

    toolchain.add_argument(
        "cmd",
        choices=["detect"],
    )

    review = (
        groups.add_parser(
            "review"
        )
    )

    review.add_argument(
        "task",
        nargs=argparse.REMAINDER,
    )

    proof = (
        groups.add_parser(
            "proof"
        )
    )

    proof.add_argument(
        "--checks",
        action="store_true",
    )

    proof.add_argument(
        "task",
        nargs=argparse.REMAINDER,
    )

    promote = (
        groups.add_parser(
            "promote"
        )
    )

    promote.add_argument(
        "path"
    )

    upstream = (
        groups.add_parser(
            "upstream"
        )
    )

    upstream_sub = (
        upstream.add_subparsers(
            dest="cmd",
            required=True,
        )
    )

    upstream_sub.add_parser(
        "refresh"
    )

    upstream_sub.add_parser(
        "status"
    )

    skills_audit = upstream_sub.add_parser(
        "skills",
        help="audit installed shared skills against their upstream git history",
    )
    skills_audit.add_argument("--write", action="store_true",
                              help="record revision, revision_checked_at and skill_status in skill-sources.json")
    skills_audit.add_argument("--source", action="append", default=[],
                              help="only this source id (repeatable)")
    skills_audit.add_argument("--exclude", action="append", default=[],
                              help="skip this source id or skill name (repeatable)")
    skills_audit.add_argument("--window", type=int, default=200,
                              help="first-parent commits of history to search (default 200)")
    skills_audit.add_argument("--jobs", type=int, default=4)
    skills_audit.add_argument("--json", action="store_true")

    args = parser.parse_args()

    if args.group == "cap":
        if args.cmd == "refresh":
            cap_refresh(
                args.quiet
            )

        elif args.cmd == "recommend":
            task = (
                " ".join(
                    args.task
                ).strip()
                or sys.stdin.read()
                .strip()
            )

            cap_recommend(
                task
            )

        elif args.cmd == "audit":
            cap_audit()

        elif args.cmd == "record":
            cap_record(
                args.caps,
                args.outcome,
                args.seconds,
            )

        elif args.cmd == "summary":
            cap_summary()

    elif args.group == "project":
        if args.cmd == "bootstrap":
            project_bootstrap(
                args.force
            )

        else:
            project_show()

    elif args.group == "toolchain":
        print(
            json.dumps(
                toolchain_info(),
                indent=2,
                ensure_ascii=False,
            )
        )

    elif args.group == "review":
        # agent-review-route (change 20261010-202747-b8cde9) judges the whole branch; the old
        # review_route() only saw `git diff HEAD` and returned no files after a worker commit.
        os.execv(str(Path.home() / "bin" / "agent-review-route"), ["agent-review-route"] + list(args.task))

    elif args.group == "proof":
        proof_capture(
            " ".join(
                args.task
            ),
            args.checks,
        )

    elif args.group == "promote":
        raise SystemExit(
            promote_skill(
                args.path
            )
        )

    elif args.group == "upstream":
        if (
            args.cmd
            == "refresh"
        ):
            upstream_refresh()

        elif args.cmd == "skills":
            raise SystemExit(
                upstream_skills(
                    write=args.write,
                    only=args.source,
                    exclude=args.exclude,
                    window=max(1, args.window),
                    as_json=args.json,
                    jobs=args.jobs,
                )
            )

        else:
            upstream_status()


if __name__ == "__main__":
    main()
