#!/usr/bin/env python3
"""agent-ship: decide where git work comes from and goes to, from evidence.

  topology [PATH] [--fetch] [--json]   remotes, canonical, mirrors, drift, CI, release tooling
  plan     [PATH] [--branch B] [--json] what to pull, where to push, what to run first
  sync     [PATH]                      fetch every remote; fast-forward clean local base branches
  ci       [PATH] [--list|--learn|--set CMD...]
                                       local CI gate for HEAD: secret scan + floor guard + the project's checks; a
                                       check that already failed when learned does not block until it passes once
                                       (ratchet). `ci --help` explains the floor guard and its ack trailer
  floor    [PATH] [--range A..B] [--committed] [--json]
                                       floor guard alone (read-only): does this change lower the bar (suppressions,
                                       skipped/deleted tests, loosened lint/coverage/strict/CI, stubs)? Default:
                                       unpublished commits + uncommitted work; run before committing
  floor --stats [--days N] [--json]    per rule: findings, acked, blocked, top ack reasons, from the evaluations
                                       `ci` records in $AGENT_SHIP_DIR/floor-log.jsonl (rotated at 1 MB)
  push     [PATH] [--branch B] [--no-ci REASON] [--dry-run]
                                       push to canonical (and fast-forward a stale mirror), never force
  release  [PATH]                      release paths by project type (test channels vs. ask-first production)
  tidy     [PATH] [--apply]            branches already merged, on GitHub, GitLab and locally (dry run by default)
  scorecard [--days N]                 per-project CI pass rate, CI time, pushes
  guard                                PreToolUse hook: blocks git pushes that break the topology

Rules (policy/DELIVERY.md): the canonical remote is where commits actually land
(the one ahead), confirmed by mirror-mechanism evidence. Push there only. A mirror is
pushed only to fast-forward a base branch to exactly the canonical commit, when its own
mirror job is not keeping up. Diverged remotes, force pushes to base branches and
pushes behind the canonical branch stop for a human.
"""
import argparse, fnmatch, glob, hashlib, json, os, re, shlex, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
PROFILES = Path(os.environ.get("AGENT_SHIP_PROFILES", HOME / ".agent-os/delivery/profiles.json"))
STATE = Path(os.environ.get("AGENT_SHIP_DIR", HOME / ".agent-os/runtime/ship"))
BASES = ("main", "master", "develop", "development", "trunk")


def git(repo, *args, check=False, timeout=120):
    p = subprocess.run(["git", "-C", str(repo), "-c", "core.quotePath=false", *args], capture_output=True, text=True,
                       encoding="utf-8", errors="replace", timeout=timeout)
    if check and p.returncode:
        raise SystemExit(f"git {' '.join(args)}: {p.stderr.strip()}")
    return p


def out(repo, *args):
    p = git(repo, *args)
    return p.stdout.strip() if p.returncode == 0 else ""


def clean_url(u):
    return re.sub(r"//[^/@]+@", "//", u)  # drop any user:token@ from https URLs


def host_kind(u):
    u = u.lower()
    if re.search(r"heroku|dokku|\.fly\.dev|render\.com|platform\.sh|azurewebsites|appspot|scalingo|clever-cloud", u):
        return "deploy"
    for k in ("github", "gitlab", "bitbucket", "codeberg", "azure"):
        if k in u:
            return k
    return "local" if u.startswith(("/", "file:", ".")) else "other"


def repo_slug(u):
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?/?$", u)
    return m.group(1).lower() if m else u.lower()


def toplevel(path):
    t = out(path, "rev-parse", "--show-toplevel")
    if not t:
        raise SystemExit(f"not a git repository: {path}")
    return Path(t)


def load_profile(remotes, root):
    try:
        data = json.loads(PROFILES.read_text())
    except (OSError, ValueError):
        return {}
    keys = [repo_slug(r["url"]) for r in remotes] + [str(root), root.name]
    defaults = data.get("defaults", {})
    for p in data.get("profiles", []):
        pats = p.get("match", [])
        if any(fnmatch.fnmatch(k, pat.lower()) or fnmatch.fnmatch(k, pat) for k in keys for pat in pats):
            return {**defaults, **p}
    return dict(defaults)


def mirror_evidence(root, remotes):
    """Files that copy commits from one host to another, as (source_kind, target_kind, file, runs_on)."""
    ev = []
    for f in sorted(glob.glob(str(root / ".github/workflows/*.y*ml"))):
        t = Path(f).read_text(errors="ignore")
        if re.search(r"git\s+push", t) and re.search(r"gitlab", t, re.I):
            ev.append({"source": "github", "target": "gitlab", "file": os.path.relpath(f, root), "runs_on": "github-actions"})
    gl = root / ".gitlab-ci.yml"
    if gl.exists():
        t = gl.read_text(errors="ignore")
        if re.search(r"git\s+push", t) and re.search(r"github\.com", t):
            ev.append({"source": "gitlab", "target": "github", "file": ".gitlab-ci.yml", "runs_on": "gitlab-ci"})
    return ev


def relation(root, a, b):
    """Commits a lacks and b lacks (behind, ahead) for refs a and b."""
    p = git(root, "rev-list", "--left-right", "--count", f"{a}...{b}")
    if p.returncode:
        return None
    left, right = map(int, p.stdout.split())
    return {"a_only": left, "b_only": right}


def ci_providers(root):
    found = []
    if glob.glob(str(root / ".github/workflows/*.y*ml")):
        found.append("github-actions")
    if (root / ".gitlab-ci.yml").exists():
        found.append("gitlab-ci")
    for f, name in (("bitbucket-pipelines.yml", "bitbucket"), (".circleci/config.yml", "circleci"),
                    ("azure-pipelines.yml", "azure"), ("Jenkinsfile", "jenkins"), ("codemagic.yaml", "codemagic"),
                    ("ci_scripts", "xcode-cloud")):
        if (root / f).exists():
            found.append(name)
    return found


def release_tooling(root):
    lanes = []
    for ff in out(root, "ls-files", "--", "fastlane/Fastfile", "*/fastlane/Fastfile").splitlines():
        for m in re.finditer(r"^\s*lane\s+:(\w+)", (root / ff).read_text(errors="ignore"), re.M):
            lanes.append(f"{ff}:{m.group(1)}")
    return {"fastlane_lanes": lanes}


CODE_HOSTS = ("github", "gitlab", "bitbucket", "codeberg", "azure")


def repo_name(u):
    return re.sub(r"\.git$", "", u.rstrip("/").split("/")[-1].split(":")[-1]).lower()


def remembered(root, value=None):
    """Last evidence-based canonical per repo, so a moment of zero drift doesn't flip the answer."""
    path = STATE / "canonical.json"
    try:
        d = json.loads(path.read_text())
    except (OSError, ValueError):
        d = {}
    if value is None:
        return d.get(str(root))
    if d.get(str(root)) != value:
        d[str(root)] = value
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(d, indent=1))


def topology(path, fetch=False):
    root = toplevel(path)
    fetch_failed = False
    if fetch:
        fetch_failed = git(root, "fetch", "--all", "--prune", "--quiet", timeout=300).returncode != 0
    remotes = []
    for name in out(root, "remote").split():
        url = out(root, "remote", "get-url", name)
        pushes = [clean_url(u) for u in out(root, "remote", "get-url", "--push", "--all", name).splitlines() if u]
        remotes.append({"name": name, "url": clean_url(url), "host": host_kind(url), "push_urls": pushes})
    prof = load_profile(remotes, root)
    names = [r["name"] for r in remotes]
    rem = {r["name"]: r for r in remotes}
    warnings, reason, ambiguous = [], "", False

    # The mirror group: the same repository on different code hosts (e.g. GitHub + GitLab).
    # Anything else (a fork's upstream, heroku/dokku deploy remotes, backups) is "other":
    # agent-ship never pushes there and the guard leaves pushes to it to the user.
    anchor = prof.get("canonical") if prof.get("canonical") in names else "origin" if "origin" in names else (names or [None])[0]
    group = []
    if anchor:
        group = [anchor] + [n for n in names if n != anchor and rem[n]["host"] in CODE_HOSTS
                            and rem[n]["host"] != rem[anchor]["host"] and repo_name(rem[n]["url"]) == repo_name(rem[anchor]["url"])]
        group += [n for n in prof.get("mirrors", []) if n in names and n not in group]
    others = [n for n in names if n not in group]

    bases = [b for b in BASES if any(git(root, "rev-parse", "-q", "--verify", f"refs/remotes/{n}/{b}").returncode == 0 for n in group)]
    heads = {n: {b: out(root, "rev-parse", "-q", "--verify", f"refs/remotes/{n}/{b}") or None for b in bases} for n in group}
    ev = mirror_evidence(root, remotes)
    by_host = {rem[n]["host"]: n for n in group}

    score = {n: 0 for n in group}
    diverged = []
    for b in bases:
        have = [n for n in group if heads[n][b]]
        for i, x in enumerate(have):
            for y in have[i + 1:]:
                r = relation(root, f"refs/remotes/{x}/{b}", f"refs/remotes/{y}/{b}")
                if not r:
                    continue
                if r["a_only"] and r["b_only"]:
                    diverged.append(f"{b}: {x} and {y} each have commits the other lacks ({r['a_only']}/{r['b_only']})")
                elif r["a_only"]:
                    score[x] += 1
                elif r["b_only"]:
                    score[y] += 1

    canonical = None
    src = [by_host[e["source"]] for e in ev if e["source"] in by_host and e["target"] in by_host]
    preferred = [n for n in group if rem[n]["host"] == prof.get("canonical_host")]
    if prof.get("canonical") in names:
        canonical, reason = prof["canonical"], "set in delivery profile"
    elif preferred:
        canonical, reason = preferred[0], f"delivery profile: canonical_host is {prof['canonical_host']}"
    elif len(group) == 1:
        canonical, reason = group[0], "only remote for this repository" if not others else "no mirror on another host; " + ", ".join(others) + " left alone"
    elif group:
        top = max(score.values())
        leaders = [n for n in group if score[n] == top]
        if top and len(leaders) == 1:
            canonical, reason = leaders[0], "the other remotes are behind it on base branches"
        elif src:
            canonical, reason = src[0], f"mirror job in {ev[0]['file']} copies from it"
        elif remembered(root) in group:
            canonical, reason = remembered(root), "remotes in sync; keeping the last evidence-based answer"
        else:
            canonical, reason, ambiguous = anchor, "remotes in sync and no mirror evidence; set `canonical` in the delivery profile", True
        if canonical and not ambiguous and fetch and not fetch_failed and reason.startswith(("the other", "mirror job")):
            remembered(root, canonical)

    for e in ev:
        if e["source"] not in by_host:
            warnings.append(f"{e['file']} pushes {e['source']}->{e['target']} from a {e['source']} project with no local remote; "
                            f"commits may also arrive on {e['target']} from there, so always sync before pushing")
        elif e["target"] in by_host and by_host[e["source"]] != canonical:
            warnings.append(f"{e['file']} copies {e['source']}->{e['target']}, the opposite direction to pushes ({canonical} first); "
                            f"harmless when both already have the same commits")
    warnings += diverged
    if fetch_failed:
        warnings.append("fetch failed; remote refs may be stale")
    if not remotes:
        warnings.append("no remote: this project exists only on this laptop (not backed up); your rule is GitHub first")
    elif prof.get("canonical_host") and not any(r["host"] == prof["canonical_host"] for r in remotes):
        warnings.append(f"not on {prof['canonical_host']} yet (your rule pushes there first); creating the repo needs your OK")
    for r in remotes:
        if len(r["push_urls"]) > 1 or (r["push_urls"] and r["push_urls"][0] != r["url"]):
            warnings.append(f"remote {r['name']} pushes to {len(r['push_urls'])} URL(s) different from its fetch URL; "
                            f"a push there also reaches: {', '.join(r['push_urls'])}")

    mirrors = []
    for n in group:
        if n == canonical:
            continue
        drift = {}
        for b in bases:
            if heads[n][b] and heads[canonical][b]:
                r = relation(root, f"refs/remotes/{canonical}/{b}", f"refs/remotes/{n}/{b}")
                if r:
                    drift[b] = {"behind": r["a_only"], "ahead": r["b_only"]}
        host = rem[n]["host"]
        mech = [e for e in ev if e["target"] == host and by_host.get(e["source"]) == canonical]
        stale = any(d["behind"] and not d["ahead"] for d in drift.values())
        mirrors.append({"name": n, "host": host, "drift": drift, "mechanism": mech,
                        "state": "diverged" if any(d["ahead"] for d in drift.values()) else
                                 "stale" if stale else "in-sync"})
        if stale:
            how = f"mirror job {mech[0]['file']} ({mech[0]['runs_on']}) is not keeping up" if mech else "no mirror job pushes it"
            warnings.append(f"{n} is behind {canonical}: " + ", ".join(f"{b} -{d['behind']}" for b, d in drift.items() if d["behind"]) + f"; {how}")

    gd = out(root, "rev-parse", "--git-common-dir")
    age = None
    if gd:
        fh = Path(gd) if Path(gd).is_absolute() else root / gd
        fh = fh / "FETCH_HEAD"
        if fh.exists():
            age = round((time.time() - fh.stat().st_mtime) / 3600, 1)
    return {"repo": str(root), "remotes": remotes, "canonical": canonical, "canonical_reason": reason,
            "ambiguous": ambiguous, "others": others, "bases": bases, "mirrors": mirrors, "mirror_evidence": ev,
            "ci": ci_providers(root), "release": release_tooling(root), "profile": prof.get("name"),
            "rules": prof.get("rules", []), "fetch_age_hours": age, "fetch_failed": fetch_failed,
            "fetched_now": fetch and not fetch_failed, "mirror_all": bool(prof.get("mirror_all_branches")),
            "warnings": warnings}


def current_branch(root):
    return out(root, "symbolic-ref", "-q", "--short", "HEAD")


def plan(path, branch=None, fetch=True):
    t = topology(path, fetch=fetch)
    root = Path(t["repo"])
    c = t["canonical"]
    branch = branch or current_branch(root)
    steps, stop = [], []
    if t["fetch_failed"]:
        stop.append("fetch failed: remote state unknown, so drift and canonical are unverified")
    if any(m["state"] == "diverged" for m in t["mirrors"]) or any("each have commits" in w for w in t["warnings"]):
        stop.append("remotes diverged: a human picks which history wins; never force")
    if not c:
        stop.append("no remote: nothing to push to")
        return {**t, "branch": branch, "steps": steps, "stop": stop}
    is_base = branch in BASES
    if t["ambiguous"] and t["mirrors"]:
        stop.append(f"cannot tell whether {c} or {', '.join(m['name'] for m in t['mirrors'])} is canonical: "
                    "set `canonical` in ~/.agent-os/delivery/profiles.json before pushing")
    up = f"refs/remotes/{c}/{branch}"
    mine = f"refs/heads/{branch}" if git(root, "rev-parse", "-q", "--verify", f"refs/heads/{branch}").returncode == 0 else "HEAD"
    if git(root, "rev-parse", "-q", "--verify", up).returncode == 0:
        r = relation(root, mine, up)
        if r and r["b_only"] and r["a_only"]:
            stop.append(f"{branch} diverged from {c}/{branch}: rebase (unpushed) or merge, never force" if not is_base
                        else f"{branch} diverged from {c}/{branch}: merge {c}/{branch} in; never force a base branch")
        elif r and r["b_only"]:
            steps.append(f"pull: fast-forward {branch} from {c}/{branch} ({r['b_only']} new)")
    base = next((b for b in t["bases"] if b != branch), None)
    if not is_base and base:
        r = relation(root, mine, f"refs/remotes/{c}/{base}")
        if r and r["b_only"]:
            steps.append(f"update: {c}/{base} has {r['b_only']} commits this branch lacks; rebase if unpushed, else merge")
    steps.append("verify: `agent-ship ci` (local CI gate: secret scan, floor guard, project checks; remote CI is a bonus, not the gate)")
    steps.append("floor: a change may not lower the bar (suppressions, skipped/deleted tests, loosened lint/coverage/strict/CI, stubs); "
                 "`agent-ship floor` before committing; a deliberate one needs `Floor-Guard-Ack: <rule> <reason>` in the commit message")
    steps.append(f"push: {c} {branch}" + ("" if is_base else f" (open the PR/MR on {next(r['host'] for r in t['remotes'] if r['name'] == c)})"))
    if t.get("mirror_all") and t["mirrors"]:
        for m in t["mirrors"]:
            steps.append(f"mirror: push the same commit of {branch} to {m['name']} (fast-forward only; skipped if {m['name']} has commits {c} lacks)")
    elif is_base:
        for m in t["mirrors"]:
            if m["state"] == "stale" or not m["mechanism"]:
                steps.append(f"mirror: fast-forward {m['name']}/{branch} to the same commit (its mirror job is not doing it)")
            else:
                steps.append(f"mirror: leave {m['name']} to {m['mechanism'][0]['file']}; confirm it caught up")
    else:
        steps.append("mirror: none; feature branches live on the canonical remote only")
    for kind, how, ask in release_paths(root):
        steps.append(f"release: {kind}: {how}" + (" - only when the user asks" if ask else " - part of shipping when the user asks to ship"))
    for rule in t["rules"]:
        steps.append(f"rule: {rule}")
    return {**t, "branch": branch, "steps": steps, "stop": stop}


def cmd_sync(a):
    root = toplevel(a.path)
    p = git(root, "fetch", "--all", "--prune", timeout=600)
    if p.returncode:
        print(p.stderr.strip(), file=sys.stderr)
        return 1
    t = topology(root)
    c, cur = t["canonical"], current_branch(root)
    dirty = bool(out(root, "status", "--porcelain", "--untracked-files=no"))
    for b in t["bases"]:
        if git(root, "rev-parse", "-q", "--verify", f"refs/heads/{b}").returncode or not c:
            continue
        r = relation(root, f"refs/heads/{b}", f"refs/remotes/{c}/{b}")
        if not r or not r["b_only"]:
            continue
        if r["a_only"]:
            print(f"{b}: diverged from {c}/{b} (local +{r['a_only']}, remote +{r['b_only']}); left alone")
        elif b == cur:
            if dirty:
                print(f"{b}: {r['b_only']} behind {c}/{b}; working tree dirty, not merging")
            else:
                m = git(root, "merge", "--ff-only", "--quiet", f"refs/remotes/{c}/{b}")
                print(f"{b}: fast-forwarded {r['b_only']} from {c}" if m.returncode == 0 else f"{b}: fast-forward failed: {m.stderr.strip()[-200:]}")
        elif b not in checked_out(root):
            u = git(root, "update-ref", f"refs/heads/{b}", f"refs/remotes/{c}/{b}", out(root, "rev-parse", f"refs/heads/{b}"))
            print(f"{b}: fast-forwarded {r['b_only']} from {c}" if u.returncode == 0 else f"{b}: update failed: {u.stderr.strip()[-200:]}")
        else:
            print(f"{b}: {r['b_only']} behind {c}/{b}; checked out in another worktree, left alone")
    for w in t["warnings"]:
        print("warning:", w)
    return 0


def checked_out(root):
    return {l.split("refs/heads/", 1)[1] for l in out(root, "worktree", "list", "--porcelain").splitlines()
            if l.startswith("branch refs/heads/")}


LEARNED = Path(os.environ.get("AGENT_SHIP_LEARNED", HOME / ".agent-os/delivery/learned"))


def full_slug(u):
    """host + full repository path (keeps GitLab subgroups apart)."""
    u = clean_url(u).lower()
    m = re.match(r"^(?:[a-z+]+://)?(?:[^@/]+@)?([^/:]+)[:/](.+?)(?:\.git)?/?$", u)
    return f"{m.group(1)}/{m.group(2)}" if m and not u.startswith(("/", ".", "file:")) else u


def repo_key(root):
    """Stable per-project key shared by every clone and worktree: the GitHub remote if any, else any remote,
    else the repository's own path (two local folders with the same name never share a key)."""
    urls = [out(root, "remote", "get-url", n) for n in out(root, "remote").split()]
    urls.sort(key=lambda u: host_kind(u) != "github")
    if urls:
        base = full_slug(urls[0])
    else:
        common = out(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
        base = f"local/{Path(common).parent.name}-{hashlib.sha256(common.encode()).hexdigest()[:10]}"
    return re.sub(r"[^A-Za-z0-9._-]+", "_", base)


def learned(root, data=None):
    path = LEARNED / f"{repo_key(root)}.json"
    if data is None:
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            return {}
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=1))
    tmp.replace(path)
    return data


def has(cmd):
    return shutil.which(cmd) is not None


def _non_posix_shebang(path):
    try:
        with open(path, "rb") as fh:
            first = fh.readline(200).decode("utf-8", "ignore")
    except OSError:
        return False
    return first.startswith("#!") and bool(re.search(r"\b(zsh|fish|t?csh)\b", first))


def detect_checks(root):
    """Candidate (setup, checks) from the project's own files. Setup prepares an environment; checks judge the code."""
    setup, checks = [], []
    build = STATE / "build" / hashlib.sha256(str(root).encode()).hexdigest()[:16]
    pkg = root / "package.json"
    if pkg.exists():
        try:
            scripts = json.loads(pkg.read_text()).get("scripts", {})
        except ValueError:
            scripts = {}
        pm = "pnpm" if (root / "pnpm-lock.yaml").exists() else "yarn" if (root / "yarn.lock").exists() else \
             "bun" if (root / "bun.lockb").exists() or (root / "bun.lock").exists() else "npm"
        if not (root / "node_modules").exists():
            setup.append({"npm": "npm ci" if (root / "package-lock.json").exists() else "npm install",
                          "pnpm": "pnpm install --frozen-lockfile", "yarn": "yarn install --frozen-lockfile",
                          "bun": "bun install --frozen-lockfile"}[pm])
        checks += [f"{pm} run {x}" for x in ("lint", "typecheck", "check", "test", "build") if x in scripts]
    if (root / "pubspec.yaml").exists():
        fl = "flutter" if re.search(r"^\s*flutter:", (root / "pubspec.yaml").read_text(errors="ignore"), re.M) else "dart"
        if not (root / ".dart_tool").exists():
            setup.append(f"{fl} pub get")
        checks.append(f"{fl} analyze")
        if (root / "test").exists():
            checks.append(f"{fl} test")
    py = root / "pyproject.toml"
    if py.exists() or (root / "pytest.ini").exists() or (root / "setup.py").exists():
        runner = "uv run " if (root / "uv.lock").exists() and has("uv") else "python3 -m "
        if py.exists() and "ruff" in py.read_text(errors="ignore") and (has("ruff") or runner.startswith("uv")):
            checks.append(f"{'uv run ' if runner.startswith('uv') else ''}ruff check .")
        if (root / "tests").exists() or (root / "test").exists():
            checks.append(f"{runner}pytest -q")
    if (root / "go.mod").exists():
        checks += ["go vet ./...", "go test ./..."]
    if (root / "Cargo.toml").exists():
        checks.append("cargo test --quiet")
    if (root / "Package.swift").exists():
        checks.append("swift test")
    if (root / "gradlew").exists():
        checks.append("./gradlew check --console=plain")
    if (root / "platformio.ini").exists():
        checks.append("pio run")
        if (root / "test").exists():
            checks.append("pio test -e native" if "env:native" in (root / "platformio.ini").read_text(errors="ignore") else "pio test --without-uploading")
    if (root / "CMakeLists.txt").exists() and not checks:
        checks.append(f"cmake -S . -B {build} && cmake --build {build} && ctest --test-dir {build} --output-on-failure")
    for mk, runner in (("Makefile", "make"), ("justfile", "just"), ("Justfile", "just")):
        f = root / mk
        if f.exists() and not checks:
            t = f.read_text(errors="ignore")
            checks += [f"{runner} {x}" for x in ("lint", "check", "test") if re.search(rf"^{x}\s*:", t, re.M)]
    lf = git(root, "ls-files", "-z", "--", "*.sh", "*.bash")
    sh = [f for f in lf.stdout.split("\0") if f] if lf.returncode == 0 else []
    sh = [f for f in sh if not _non_posix_shebang(root / f)]  # shellcheck can't parse zsh/fish/csh (SC1071)
    if sh and has("shellcheck"):
        checks.append("shellcheck -S error -- " + " ".join(shlex.quote(f) for f in sh[:200]))
    return setup, checks


def ci_commands(root, prof):
    """(setup, checks, source). Profile beats learned beats detected."""
    if prof.get("ci"):
        return list(prof.get("setup", [])), list(prof["ci"]), "profile"
    L = learned(root)
    det_setup, det = detect_checks(root)
    if L.get("commands"):
        return det_setup if not L.get("setup") else list(L["setup"]), list(L["commands"]), "learned"
    return det_setup, det, "detected"


SECRET_PATTERNS = [
    ("private key", r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY"),
    ("AWS access key", r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"),
    ("GitHub token", r"\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,})\b"),
    ("GitLab token", r"\bglpat-[A-Za-z0-9_-]{20,}\b"),
    ("Slack token", r"\bxox[abprs]-[A-Za-z0-9-]{10,}\b"),
    ("Google API key", r"\bAIza[0-9A-Za-z_-]{35}\b"),
    ("Stripe live key", r"\b[rs]k_live_[0-9A-Za-z]{20,}\b"),
    ("OpenAI/Anthropic key", r"\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{32,}\b"),
    ("JWT", r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}"),
    ("credentials in URL", r"\b[a-z][a-z0-9+.-]*://[^/\s:@'\"]+:[^/\s@'\"]{6,}@[^\s'\"]+"),
    ("password assignment", r"(?i)\b(?:password|passwd|secret|api_?key|access_?token|auth_?token)\s*[:=]\s*['\"][^'\"\s$<{]{12,}['\"]"),
    ("dotenv secret", r"(?i)^\s*(?:export\s+)?[A-Z0-9_]*(?:SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE_?KEY|DATABASE_URL)[A-Z0-9_]*\s*=\s*['\"]?[^\s'\"#$<{]{8,}"),
]
SECRET_FILES = re.compile(r"(^|/)(\.env(\.(?!vault$|d\.ts$)[\w.-]+)?|id_[rd]sa|id_ecdsa|id_ed25519|[^/]*\.(p12|pfx|jks)|"
                          r"[^/]*\.keystore|AuthKey_[A-Z0-9]+\.p8|service-account[^/]*\.json|credentials\.json|[^/]*\.pem)$", re.I)
KEY_BLOB = re.compile(r"\.(p12|pfx|jks|keystore|p8)$", re.I)  # binary keys: no content scan, so no test-dir pass
SECRET_FILE_OK = re.compile(r"(^|/)(debug\.keystore)$|(^|/)(test|tests|fixtures?|testdata|__fixtures__|spec)/|\.(example|sample|template)$", re.I)
PLACEHOLDER = re.compile(r"(?i)example|placeholder|dummy|changeme|your[_-]|xxxx|^<[^>]+>$|^\$\{|redacted|fake|test[_-]?key")
ALLOW_LINE = re.compile(r"agent-ship:\s*allow-secret")


def push_range(root):
    """Commits a push of HEAD would publish: those not on any canonical remote branch, else the whole history.

    Anything already on the canonical remote (base branches, merged-in main from a `-s ours`
    release merge, the branch's own pushed commits) is published and is not rescanned."""
    c = topology(root)["canonical"]
    if c and out(root, "for-each-ref", "--count=1", f"refs/remotes/{c}/"):
        return f"HEAD --not --remotes={c}"
    return "HEAD"


def added_lines(diff):
    """(file, added line) from `git log -p --cc` output, including lines a merge commit introduced."""
    cur, cc, hdr = "", 1, False
    for line in diff.splitlines():
        if line.startswith(("diff --cc ", "diff --combined ")):
            cur, cc, hdr = line.split(" ", 2)[2], 2, True
        elif line.startswith("diff --git "):
            cc, hdr = 1, True
        elif hdr and line.startswith("+++ "):
            cur = line[6:] if line.startswith("+++ b/") else cur
        elif line.startswith("@@"):
            hdr = False
        elif not hdr and line[:cc].count("+") and "-" not in line[:cc]:
            yield cur, line[cc:]


def secret_scan(root, rng, allow=()):
    hits = []
    if has("gitleaks"):
        p = subprocess.run(["gitleaks", "git", "--no-banner", "--redact", "--log-opts", rng, str(root)],
                           capture_output=True, text=True, timeout=600, stdin=subprocess.DEVNULL)
        if p.returncode == 1:
            hits.append("gitleaks: " + (p.stdout + p.stderr).strip()[-600:])
    names = out(root, "log", "--format=", "--name-only", "-M", "--diff-filter=ACR", *rng.split()).splitlines()
    for f in sorted(set(names)):
        exempt = SECRET_FILE_OK.search(f) and not (KEY_BLOB.search(f) and not f.endswith("debug.keystore"))
        if SECRET_FILES.search(f) and not exempt and not any(fnmatch.fnmatch(f, g) for g in allow):
            hits.append(f"secret-looking file committed: {f}")
    for f, line in added_lines(out(root, "log", "-p", "--cc", "--format=", "--no-color", "-U0", *rng.split())):
        if ALLOW_LINE.search(line) or any(fnmatch.fnmatch(f, g) for g in allow):
            continue
        for name, rx in SECRET_PATTERNS:
            if name == "dotenv secret" and not re.search(r"(^|/)\.env", f):
                continue
            m = next((m for m in re.finditer(rx, line) if not PLACEHOLDER.search(m.group(0))), None)
            if m:
                hits.append(f"{name} in {f}")
                break
    return sorted(set(hits))


# ---------------------------------------------------------------------------------------------------
# Floor guard: block changes that lower the quality bar instead of meeting it. Diff-only: it reads
# the lines a change adds and removes (never the whole codebase, so existing suppressions are not
# re-litigated), reports rule + file:line, stays silent on tightening and loud on loosening, and a
# guard that could not run never reads as clean.
# Adapted from the floor-guard reference in addyosmani/agent-skills
# (skills/constraint-driven-development/references/floor-guard.md), MIT License,
# Copyright (c) 2025 Addy Osmani. Re-implemented for agent-ship's push range, with rename
# detection, an acknowledgement trailer, and Dart/Swift/Kotlin/Go/Rust/config-file rules.
# ---------------------------------------------------------------------------------------------------
FLOOR_RULES = {
    "suppression": "new checker suppression comment",
    "skip-test": "test skipped or marked expected-to-fail",
    "focus-test": "focused test (silently skips every other test)",
    "test-deleted": "test file deleted and its assertions not re-homed",
    "assert-removed": "assertions removed from tests without replacements",
    "threshold-lowered": "coverage threshold lowered or removed",
    "lint-downgraded": "lint rule removed, disabled or downgraded",
    "strict-off": "strictness flag turned off",
    "no-verify": "--no-verify added (skips git hooks)",
    "ci-weakened": "CI step commented out, allowed to fail or disabled",
    "stub": "unimplemented stub added to non-test code",
}
FLOOR_HELP = """floor guard (runs inside `ci`; standalone: `agent-ship floor`):
  blocks a change that lowers the bar: new suppressions, skipped/focused/deleted tests, stripped
  assertions, lowered coverage thresholds, downgraded lint, strict flags off, --no-verify, weakened CI
  steps, unimplemented stubs. Only lines the change adds/removes count; vendored/generated paths and
  pure renames are ignored.
  Rules: """ + ", ".join(FLOOR_RULES) + """.
  A deliberate one needs a trailer in a commit message of the range, with a real reason:
      Floor-Guard-Ack: <rule>[,<rule>...][@<path-glob>] <reason>
      e.g. Floor-Guard-Ack: skip-test@test/net/* flaky upstream API, tracked in #123
  Per project, in ~/.agent-os/delivery/profiles.json: "floor_guard": false (off), "floor_ignore": [path globs],
  "floor_allow": [regexes for an agreed idiom, e.g. "noqa: TCH00[12]"]; each needs a "why"."""
FLOOR_ACK = re.compile(r"^[ \t]*Floor-Guard-Ack:[ \t]*(\S+)[ \t]*(.*?)[ \t]*$", re.M | re.I)
FLOOR_ASSERT_MIN = 3  # net assertions removed from surviving test files before it counts
