    r"\.generated\.\w+$|\.min\.(js|css)$|"
    r"(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|pubspec\.lock|Podfile\.lock|Cargo\.lock|go\.sum|poetry\.lock|uv\.lock)$")
FLOOR_DOCS = re.compile(r"\.(md|mdx|markdown|txt|rst|adoc|html?|svg)$|(^|/)(CHANGELOG|LICENSE|NOTICE)[^/]*$", re.I)
FLOOR_GENERATED = re.compile(r"GENERATED CODE|DO NOT (EDIT|MODIFY)|@generated|Code generated .* DO NOT EDIT|auto-?generated", re.I)
