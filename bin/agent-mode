#!/usr/bin/env python3

from pathlib import Path
import sys

p = Path.home() / ".agent-os" / "mode"
valid = {"owner", "work", "personal", "guest"}

if len(sys.argv) == 1:
    print(p.read_text().strip() if p.exists() else "owner")
    raise SystemExit(0)

mode = sys.argv[1].strip().lower()

if mode not in valid:
    print("Use: agent-mode owner|work|personal|guest", file=sys.stderr)
    raise SystemExit(1)

p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(mode + "\n")

print(f"AgentOS mode: {mode}")

if mode == "guest":
    print("Private authenticated connectors are policy-blocked in guest mode.")
