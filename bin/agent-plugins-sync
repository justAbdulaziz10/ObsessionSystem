#!/usr/bin/env python3
"""agent-plugins-sync: share local/user plugin state and the MCP deny list between
the two Claude accounts (run by launchd com.agentos.plugins-sync with --quiet).

Usage:
  agent-plugins-sync [--quiet]            sync (deny list only once enabled, see below)
  agent-plugins-sync --check | --dry-run  report deny-list drift, write nothing; exit 1 on drift
  agent-plugins-sync --enable-denied-sync first deny-list sync: union of the canonical file and
                                          both accounts, recorded as the baseline

deniedMcpServers: the canonical list is ~/.agent-os/claude-plugins/denied-mcp-servers.json.
Once a baseline exists (state 'denied'), every run three-way merges edits from the canonical
file and both settings.json files against the baseline (additions and removals from any side
propagate; a file without the key has no opinion) and writes the result to all three.
"""

from pathlib import Path
from datetime import datetime
import hashlib
import json
import os
import shutil
import subprocess
import sys

HOME = Path.home()

ROOT = HOME / ".agent-os" / "claude-plugins"
SHARED = ROOT / "shared"

C1 = HOME / ".claude"
C2 = HOME / ".claude_second"

PLUGIN_DIRS = [
    C1 / "plugins",
    C2 / "plugins",
]

STATE = (
    HOME
    / ".agent-os"
    / "state"
    / "plugin-sync.json"
)

DENIED_FILE = ROOT / "denied-mcp-servers.json"

PRIVATE_TOP_LEVEL = {
    "synced",
}


def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def load_settings(path):
    # A settings file that exists but does not parse (mid-write by Claude
    # Code, or a hand edit in progress) must never be treated as {}: the
    # write-back would wipe it and propagate empty enabledPlugins.
    if not path.exists():
        return {}

    try:
        data = json.loads(path.read_text())
    except Exception as exc:
        print(
            f"agent-plugins-sync: skipping cycle, unreadable {path}: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(0)

    if not isinstance(data, dict):
        print(
            f"agent-plugins-sync: skipping cycle, {path} is not a JSON object",
            file=sys.stderr,
        )
        raise SystemExit(0)

    return data


def save_json(path, data):
    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    text = json.dumps(
        data,
        indent=2,
        ensure_ascii=False,
    ) + "\n"

    # Write only on change, atomically, so live readers never see a
    # truncated file and WatchPaths is not re-triggered by no-op writes.
    try:
        if path.read_text() == text:
            return
    except Exception:
        pass

    target = path.resolve() if path.is_symlink() else path

    tmp = target.with_name(
        f".{target.name}.agentos-tmp-{os.getpid()}"
    )

    tmp.write_text(text)

    try:
        os.chmod(tmp, target.stat().st_mode & 0o7777)
    except Exception:
        pass

    os.replace(tmp, target)


def digest(obj):
    raw = json.dumps(
        obj,
        sort_keys=True,
        ensure_ascii=False,
    ).encode()

    return hashlib.sha256(raw).hexdigest()


def merge_tree(src, dst):
    dst.mkdir(
        parents=True,
        exist_ok=True,
    )

    for item in list(src.rglob("*")):
        rel = item.relative_to(src)
        target = dst / rel

        try:
            if item.is_dir():
                target.mkdir(
                    parents=True,
                    exist_ok=True,
                )

            elif item.is_symlink():
                if not target.exists():
                    target.parent.mkdir(
                        parents=True,
                        exist_ok=True,
                    )
                    target.symlink_to(
                        os.readlink(item)
                    )

            elif item.is_file():
                target.parent.mkdir(
                    parents=True,
                    exist_ok=True,
                )

                if not target.exists():
                    shutil.copy2(
                        item,
                        target,
                    )

                elif (
                    item.stat().st_mtime
                    > target.stat().st_mtime
                ):
                    try:
                        target.chmod(
                            target.stat().st_mode
                            | 0o600
                        )
                    except Exception:
                        pass

                    shutil.copy2(
                        item,
                        target,
                    )

        except Exception:
            pass


def reconcile_plugin_files():
    SHARED.mkdir(
        parents=True,
        exist_ok=True,
    )

    for plugins in PLUGIN_DIRS:
        plugins.mkdir(
            parents=True,
            exist_ok=True,
        )

        synced = plugins / "synced"

        # synced must NEVER point at shared storage.
        if synced.is_symlink():
            synced.unlink()

        synced.mkdir(
            parents=True,
            exist_ok=True,
        )

        # Anything except synced belongs to the shared
        # local/user plugin layer.
        for item in list(
            plugins.iterdir()
        ):
            if item.name in PRIVATE_TOP_LEVEL:
                continue

            target = SHARED / item.name

            if item.is_symlink():
                try:
                    if (
                        item.resolve()
                        == target.resolve()
                    ):
                        continue
                except Exception:
                    pass

                item.unlink()

            elif item.is_dir():
                if not target.exists():
                    shutil.move(
                        str(item),
                        str(target),
                    )
                else:
                    merge_tree(
                        item,
                        target,
                    )

                    shutil.rmtree(
                        item,
                        ignore_errors=True,
                    )

            elif item.is_file():
                if not target.exists():
                    shutil.move(
                        str(item),
                        str(target),
                    )
                else:
                    try:
                        if (
                            item.stat().st_mtime
                            > target.stat().st_mtime
                        ):
                            shutil.copy2(
                                item,
                                target,
                            )
                    except Exception:
                        pass

                    item.unlink(
                        missing_ok=True,
                    )

        # Expose all shared local plugin state to both accounts.
        for shared_item in SHARED.iterdir():
            link = (
                plugins
                / shared_item.name
            )

            if link.exists() or link.is_symlink():
                continue

            link.symlink_to(
                shared_item
            )


def split_enabled(data):
    enabled = data.get(
        "enabledPlugins",
        {},
    )

    if not isinstance(enabled, dict):
        enabled = {}

    shared = {}
    synced = {}

    for key, value in enabled.items():
        if key.endswith("@synced"):
            synced[key] = value
        else:
            shared[key] = value

    return shared, synced


def local_section(data):
    shared_enabled, _ = split_enabled(
        data
    )

    marketplaces = data.get(
        "extraKnownMarketplaces",
        {},
    )

    if not isinstance(
        marketplaces,
        dict,
    ):
        marketplaces = {}

    return {
        "enabledPlugins":
            shared_enabled,
        "extraKnownMarketplaces":
            marketplaces,
    }


def merge_initial(a, b):
    enabled = {}

    for src in [
        a.get(
            "enabledPlugins",
            {},
        ),
        b.get(
            "enabledPlugins",
            {},
        ),
    ]:
        for key, value in src.items():
            if bool(value):
                enabled[key] = True

    marketplaces = {}

    for src in [
        a.get(
            "extraKnownMarketplaces",
            {},
        ),
        b.get(
            "extraKnownMarketplaces",
            {},
        ),
    ]:
        marketplaces.update(src)

    return {
        "enabledPlugins": enabled,
        "extraKnownMarketplaces":
            marketplaces,
    }


class DeniedUnreadable(Exception):
    pass


def denied_key(entry):
    return json.dumps(
        entry,
        sort_keys=True,
        ensure_ascii=False,
    )


def denied_list(value):
    """A settings/canonical value as a deduplicated list, or None (no opinion)."""
    if not isinstance(value, list):
        return None

    out, seen = [], set()

    for entry in value:
        k = denied_key(entry)

        if k not in seen:
            seen.add(k)
            out.append(entry)

    return out


def load_denied_canonical():
    if not DENIED_FILE.exists():
        return None

    try:
        data = json.loads(DENIED_FILE.read_text())
    except Exception as exc:
        raise DeniedUnreadable(f"unreadable {DENIED_FILE}: {exc}")

    if not isinstance(data, dict) or not isinstance(data.get("deniedMcpServers"), list):
        raise DeniedUnreadable(f"{DENIED_FILE} has no deniedMcpServers list")

    return denied_list(data["deniedMcpServers"])


def save_denied_canonical(entries):
    try:
        data = json.loads(DENIED_FILE.read_text())
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}

    if denied_list(data.get("deniedMcpServers")) == entries:
        return

    data["deniedMcpServers"] = entries
    data["updated_at"] = datetime.now().astimezone().isoformat()

    save_json(DENIED_FILE, data)


def plan_denied(d1, d2, state, enable):
    """Return (result list or None, report dict). None = leave deny lists alone."""
    base = denied_list(state.get("denied"))

    if base is None and not enable:
        return None, {"status": "disabled"}

    canonical = load_denied_canonical()
    sides = [
        ("canonical", canonical),
        ("claude1", denied_list(d1.get("deniedMcpServers"))),
        ("claude2", denied_list(d2.get("deniedMcpServers"))),
    ]
    present = [(n, v) for n, v in sides if v is not None]

    if not present and base is None:
        return None, {"status": "nothing-to-sync"}

    if base is None:
        # First sync: union; a deny list only grows without an explicit edit.
        result, seen = [], set()

        for _, entries in present:
            for e in entries:
                k = denied_key(e)
                if k not in seen:
                    seen.add(k)
                    result.append(e)

        return result, {"status": "initialised", "sources": [n for n, _ in present]}

    base_keys = [denied_key(e) for e in base]
    base_set = set(base_keys)
    removed, added, added_keys, changed = set(), [], set(), []

    for name, entries in present:
        keys = {denied_key(e): e for e in entries}

        if set(keys) == base_set:
            continue

        changed.append(name)
        removed |= base_set - set(keys)

        for k, e in keys.items():
            if k not in base_set and k not in added_keys:
                added_keys.add(k)
                added.append(e)

    result = [e for e, k in zip(base, base_keys) if k not in removed] + added

    return result, {
        "status": "merged",
        "changed": changed,
        "added": len(added),
        "removed": len(removed),
    }


def sync_settings(enable_denied=False):
    p1 = C1 / "settings.json"
    p2 = C2 / "settings.json"

    d1 = load_settings(p1)
    d2 = load_settings(p2)

    try:
        denied, denied_report = plan_denied(
            d1,
            d2,
            load_json(STATE, {}),
            enable_denied,
        )
    except DeniedUnreadable as exc:
        print(
            f"agent-plugins-sync: deny list not synced this cycle: {exc}",
            file=sys.stderr,
        )
        denied, denied_report = None, {"status": "error", "error": str(exc)}

    local1 = local_section(d1)
    local2 = local_section(d2)

    state = load_json(
        STATE,
        {},
    )

    h1 = digest(local1)
    h2 = digest(local2)

    old1 = state.get("hash1")
    old2 = state.get("hash2")

    changed1 = (
        old1 is not None
        and h1 != old1
    )

    changed2 = (
        old2 is not None
        and h2 != old2
    )

    canonical = state.get(
        "canonical"
    )

    if not isinstance(
        canonical,
        dict,
    ):
        canonical = merge_initial(
            local1,
            local2,
        )

    elif changed1 and not changed2:
        canonical = local1

    elif changed2 and not changed1:
        canonical = local2

    elif changed1 and changed2:
        if h1 == h2:
            canonical = local1
        else:
            try:
                m1 = p1.stat().st_mtime
            except Exception:
                m1 = 0

            try:
                m2 = p2.stat().st_mtime
            except Exception:
                m2 = 0

            canonical = (
                local1
                if m1 >= m2
                else local2
            )

    for path, data in [
        (p1, d1),
        (p2, d2),
    ]:
        # Preserve account-specific synced plugin overrides.
        _, synced_enabled = split_enabled(
            data
        )

        combined = dict(
            canonical.get(
                "enabledPlugins",
                {},
            )
        )

        combined.update(
            synced_enabled
        )

        data[
            "enabledPlugins"
        ] = combined

        data[
            "extraKnownMarketplaces"
        ] = canonical.get(
            "extraKnownMarketplaces",
            {},
        )

        # Default behavior for a claude.ai-authenticated
        # account is to sync its OWN cloud plugins/skills.
        # Remove old user-level opt-out flags.
        if (
            data.get(
                "syncClaudeAiPlugins"
            )
            is False
        ):
            data.pop(
                "syncClaudeAiPlugins",
                None,
            )

        if (
            data.get(
                "syncClaudeAiSkills"
            )
            is False
        ):
            data.pop(
                "syncClaudeAiSkills",
                None,
            )

        env = data.setdefault(
            "env",
            {},
        )

        env.pop(
            "CLAUDE_CODE_PLUGIN_CACHE_DIR",
            None,
        )

        env[
            "CLAUDE_CODE_SYNC_PLUGIN_INSTALL"
        ] = "1"

        env[
            "CLAUDE_CODE_ENABLE_BACKGROUND_PLUGIN_REFRESH"
        ] = "1"

        if denied is not None:
            data["deniedMcpServers"] = denied

        save_json(
            path,
            data,
        )

    if denied is not None:
        save_denied_canonical(denied)

    d1 = load_settings(p1)
    d2 = load_settings(p2)

    previous = load_json(STATE, {})

    state = {
        "denied":
            denied
            if denied is not None
            else previous.get("denied"),

        "updated_at":
            datetime.now()
            .astimezone()
            .isoformat(),

        "hash1": digest(
            local_section(d1)
        ),

        "hash2": digest(
            local_section(d2)
        ),

        "canonical":
            canonical,

        "capabilities_digest":
            previous.get(
                "capabilities_digest"
            ),
    }

    if state["denied"] is None:
        state.pop("denied")

    save_json(
        STATE,
        state,
    )

    return denied_report


def check_denied():
    """Report deny-list drift without writing anything. Exit 1 on drift."""
    p1 = C1 / "settings.json"
    p2 = C2 / "settings.json"
    d1 = load_settings(p1)
    d2 = load_settings(p2)
    state = load_json(STATE, {})

    try:
        canonical = load_denied_canonical()
    except DeniedUnreadable as exc:
        print(f"ERROR {exc}")
        return 2

    sides = [
        (str(DENIED_FILE), canonical),
        (str(p1), denied_list(d1.get("deniedMcpServers"))),
        (str(p2), denied_list(d2.get("deniedMcpServers"))),
    ]
    baseline = denied_list(state.get("denied"))
    enabled = baseline is not None
    result, report = plan_denied(d1, d2, state, True)
    target = {denied_key(e) for e in (result or [])}

    print("AgentOS deny-list check (deniedMcpServers; nothing written)")
    print()
    print(
        "sync:",
        "enabled (baseline %d entries)" % len(baseline)
        if enabled
        else "NOT enabled yet: launchd runs leave deny lists alone until "
        "`agent-plugins-sync --enable-denied-sync`",
    )
    print("a sync would produce %d entries (%s)" % (len(target), report.get("status")))
    print()

    drift = False

    for name, entries in sides:
        if entries is None:
            print(f"  {name}: no deniedMcpServers (no opinion)")
            drift = True
            continue

        keys = {denied_key(e) for e in entries}
        missing = sorted(target - keys)
        extra = sorted(keys - target)
        same = not missing and not extra
        drift = drift or not same
        print(
            f"  {name}: {len(entries)} entries"
            + ("  in sync" if same else f"  DRIFT: +{len(missing)} to add, -{len(extra)} to remove")
        )

        for k in missing:
            print(f"      + {k}")

        for k in extra:
            print(f"      - {k}")

    print()
    print("DRIFT" if drift else "IN SYNC")

    return 1 if drift else 0


def refresh_capabilities():
    cap = (
        HOME
        / "bin"
        / "agent-cap"
    )

    if not cap.exists():
        return

    # Rebuild the (multi-MB, up to ~25s) index only when plugin or MCP
    # inputs changed, or daily — not on every 60s launchd tick.
    inputs = {}

    for p in [
        C1 / "settings.json",
        C2 / "settings.json",
        SHARED / "installed_plugins.json",
        HOME / ".claude.json",
        C2 / ".claude.json",
        HOME / ".codex" / "config.toml",
    ]:
        try:
            if p.name == ".claude.json":
                inputs[str(p)] = sorted(
                    (load_json(p, {}).get("mcpServers") or {}).keys()
                )
            elif p.name == "settings.json":
                inputs[str(p)] = local_section(load_json(p, {}))
            else:
                inputs[str(p)] = p.read_text()
        except Exception:
            inputs[str(p)] = None

    for plugins in PLUGIN_DIRS:
        inputs[str(plugins / "synced")] = sorted(
            m.name
            for m in (plugins / "synced").glob("*/*.meta.json")
        )

    current = digest(inputs)

    index = HOME / ".agent-os" / "capabilities" / "index-v3.json"

    state = load_json(STATE, {})

    try:
        age = datetime.now().timestamp() - index.stat().st_mtime
    except Exception:
        age = None

    if (
        state.get("capabilities_digest") == current
        and age is not None
        and age < 86400
    ):
        return

    env = os.environ.copy()

    env["PATH"] = os.pathsep.join(
        [
            str(HOME / ".local" / "bin"),
            str(HOME / "bin"),
            "/opt/homebrew/bin",
            "/usr/local/bin",
            env.get("PATH", "/usr/bin:/bin:/usr/sbin:/sbin"),
        ]
    )

    rc = subprocess.run(
        [
            str(cap),
            "refresh",
            "--quiet",
        ],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode

    if rc == 0:
        state["capabilities_digest"] = current

        save_json(
            STATE,
            state,
        )


FLAGS = {"--quiet", "--check", "--dry-run", "--enable-denied-sync", "--help", "-h"}

unknown_flags = [a for a in sys.argv[1:] if a not in FLAGS]

if unknown_flags or "--help" in sys.argv or "-h" in sys.argv:
    print(__doc__)
    raise SystemExit(2 if unknown_flags else 0)

if "--check" in sys.argv or "--dry-run" in sys.argv:
    raise SystemExit(check_denied())

reconcile_plugin_files()
denied_report = sync_settings(
    enable_denied="--enable-denied-sync" in sys.argv,
)
refresh_capabilities()

if "--quiet" not in sys.argv:
    print("AgentOS plugin sync")
    print()
    print(
        "✅ Local/user plugin data shared"
    )
    print(
        "✅ Local enabled state shared"
    )
    print(
        "✅ Marketplaces shared"
    )
    print(
        "✅ @synced state remains account-specific"
    )
    print(
        "✅ Claude.ai plugin opt-out removed"
    )
    print(
        "✅ deniedMcpServers:",
        json.dumps(denied_report, ensure_ascii=False),
    )
    print()
    print(
        "Claude 1 cloud sync:",
        C1 / "plugins" / "synced",
    )
    print(
        "Claude 2 cloud sync:",
        C2 / "plugins" / "synced",
    )
